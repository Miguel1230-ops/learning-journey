			<Item class="LocalScript" referent="RBXGeodaServicioCueva">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Controles y guía contextual de la expedición a la Geoda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Controles = require(ReplicatedStorage:WaitForChild("ControlesCombate"))

local jugador = Players.LocalPlayer
local playerGui = jugador:WaitForChild("PlayerGui")
local cueva = workspace:WaitForChild("CuevaDeLaGeoda")
local guardian = cueva:WaitForChild("Guardian")
local cristal = guardian:WaitForChild("CristalEspalda")
local puerta = cueva:WaitForChild("Ruta"):WaitForChild("PuertaViento")
local accion = ReplicatedStorage:WaitForChild("AccionGeoda")

local CARBON = Color3.fromRGB(14, 24, 36)
local PIZARRA = Color3.fromRGB(33, 51, 69)
local PERLA = Color3.fromRGB(246, 249, 247)
local SUAVE = Color3.fromRGB(208, 223, 231)
local APAGADO = Color3.fromRGB(139, 162, 177)
local MENTA = Color3.fromRGB(124, 242, 206)
local ORO = Color3.fromRGB(255, 210, 126)
local AZUL = Color3.fromRGB(153, 220, 255)
local CORAL = Color3.fromRGB(255, 151, 138)

-- Mismas distancias, altura y orientación que valida Guardian.server.luau.
local DISTANCIA_COMETA_MINIMA = 0.2
local DISTANCIA_COMETA = 26
local DISTANCIA_CRISTAL = 8
local LIMITE_DEL_FRENTE = 0.35

local function redondear(objeto, radio)
	local curva = Instance.new("UICorner")
	curva.CornerRadius = UDim.new(0, radio)
	curva.Parent = objeto
end

local function borde(objeto, tono, grosor, transparencia)
	local linea = Instance.new("UIStroke")
	linea.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	linea.Color = tono
	linea.Thickness = grosor
	linea.Transparency = transparencia or 0
	linea.Parent = objeto
	return linea
end

local function etiqueta(padre, nombre, texto, tono, tamano, pos, medida, negrita)
	local e = Instance.new("TextLabel")
	e.Name = nombre
	e.Position = pos
	e.Size = medida
	e.BackgroundTransparency = 1
	e.Text = texto
	e.TextColor3 = tono
	e.TextSize = tamano
	e.Font = if negrita then Enum.Font.GothamBold else Enum.Font.GothamMedium
	e.TextXAlignment = Enum.TextXAlignment.Left
	e.TextWrapped = true
	e.Parent = padre
	return e
end

local function superficie(padre, clase, nombre, medida, ancho, pos, ancla)
	local f = Instance.new(clase)
	f.Name = nombre
	f.Size = medida
	f.AnchorPoint = ancla or Vector2.zero
	f.Position = pos
	f.BackgroundColor3 = CARBON
	f.BackgroundTransparency = 0.08
	f.BorderSizePixel = 0
	redondear(f, 11)
	local limite = Instance.new("UISizeConstraint")
	limite.MaxSize = Vector2.new(ancho, medida.Y.Offset)
	limite.Parent = f
	f.Parent = padre
	return f
end

local gui = Instance.new("ScreenGui")
gui.Name = "CuevaDeLaGeodaHUD"
gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = playerGui

local guardia = superficie(gui, "Frame", "VidaDelGuardian", UDim2.fromOffset(204, 33), 204,
	UDim2.new(0.5, 0, 0, 8), Vector2.new(0.5, 0))
borde(guardia, PIZARRA, 1)
etiqueta(guardia, "Nombre", "GUARDIÁN", SUAVE, 11, UDim2.fromOffset(13, 5), UDim2.fromOffset(101, 23), true)
local cristales = {}
for i = 1, 3 do
	local cristalVida = Instance.new("Frame")
	cristalVida.Name = "Cristal" .. i
	cristalVida.Size = UDim2.fromOffset(12, 12)
	cristalVida.Position = UDim2.fromOffset(123 + (i - 1) * 25, 11)
	cristalVida.BorderSizePixel = 0
	cristalVida.Rotation = 45
	cristalVida.BackgroundColor3 = ORO
	redondear(cristalVida, 2)
	local filo = borde(cristalVida, ORO, 1, 0.14)
	cristalVida.Parent = guardia
	cristales[i] = { pieza = cristalVida, filo = filo }
end

local objetivo = superficie(gui, "Frame", "Objetivo", UDim2.new(1, -26, 0, 67), 316,
	UDim2.fromOffset(13, 8))
borde(objetivo, PIZARRA, 1)
local titulo = etiqueta(objetivo, "Titulo", "", PERLA, 15, UDim2.fromOffset(13, 5), UDim2.new(1, -26, 0, 23), true)
local pista = etiqueta(objetivo, "Pista", "", SUAVE, 12, UDim2.fromOffset(13, 29), UDim2.new(1, -26, 0, 31), false)

local aviso = superficie(gui, "TextButton", "Instruccion", UDim2.new(1, -32, 0, 53), 326,
	UDim2.new(0.5, 0, 1, -50), Vector2.new(0.5, 1))
aviso.Text = ""
aviso.AutoButtonColor = false
aviso.Selectable = false
aviso.Visible = false
local filoAviso = borde(aviso, MENTA, 1, 0.28)
local tecla = Instance.new("TextLabel")
tecla.Name = "Tecla"
tecla.Position = UDim2.fromOffset(9, 9)
tecla.Size = UDim2.fromOffset(51, 35)
tecla.BackgroundColor3 = MENTA
tecla.BorderSizePixel = 0
tecla.Font = Enum.Font.GothamBold
tecla.TextColor3 = CARBON
tecla.TextSize = 13
redondear(tecla, 8)
tecla.Parent = aviso
local tituloAviso = etiqueta(aviso, "Accion", "", PERLA, 16, UDim2.fromOffset(70, 5), UDim2.new(1, -79, 0, 21), true)
local detalleAviso = etiqueta(aviso, "Detalle", "", SUAVE, 11, UDim2.fromOffset(70, 27), UDim2.new(1, -79, 0, 21), false)

local ayuda = superficie(gui, "Frame", "Controles", UDim2.new(1, -34, 0, 25), 318,
	UDim2.new(0.5, 0, 1, -12), Vector2.new(0.5, 1))
local teclas = etiqueta(ayuda, "Teclas", "", SUAVE, 11, UDim2.fromOffset(8, 0), UDim2.new(1, -16, 1, 0), true)
teclas.TextXAlignment = Enum.TextXAlignment.Center

local function botonMovil(nombre, margen)
	local b = superficie(gui, "TextButton", nombre, UDim2.fromOffset(101, 43), 101,
		UDim2.new(1, -17, 1, -margen), Vector2.new(1, 1))
	b.TextColor3 = PERLA
	b.TextSize = 13
	b.Font = Enum.Font.GothamBold
	b.Visible = false
	borde(b, PIZARRA, 1)
	return b
end
local botonPulso = botonMovil("Rafaga", 124)
local botonCompanero = botonMovil("Companero", 175)
local botonEscudo = botonMovil("EscudoPedernal", 226)

local marcador = Instance.new("BillboardGui")
marcador.Name = "CristalExpuesto"
marcador.Adornee = cristal
marcador.Size = UDim2.fromOffset(88, 25)
marcador.StudsOffsetWorldSpace = Vector3.new(0, 1.9, 0)
marcador.MaxDistance = 42
marcador.Enabled = false
marcador.Parent = playerGui
local marca = etiqueta(marcador, "Marca", "PUNTO DÉBIL", MENTA, 10, UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1), true)
marca.TextXAlignment = Enum.TextXAlignment.Center
marca.TextStrokeColor3 = CARBON
marca.TextStrokeTransparency = 0.25

local hudIsla
local estadoIsla
local function actualizarPantallas()
	local dentro = jugador:GetAttribute("EnCueva") == true
	gui.Enabled = dentro and jugador:GetAttribute("GeodaPresentando") ~= true
	if not gui.Enabled then
		marcador.Enabled = false
	end
	local uiIsla = playerGui:FindFirstChild("IslaDelVientoHUD")
	if uiIsla and uiIsla:IsA("ScreenGui") then
		if dentro then
			if hudIsla ~= uiIsla then
				hudIsla = uiIsla
				estadoIsla = uiIsla.Enabled
			end
			uiIsla.Enabled = false
		elseif hudIsla == uiIsla then
			uiIsla.Enabled = estadoIsla
			hudIsla, estadoIsla = nil, nil
		end
	end
end
playerGui.ChildAdded:Connect(function(nuevo)
	if nuevo.Name == "IslaDelVientoHUD" then
		actualizarPantallas()
	end
end)
jugador:GetAttributeChangedSignal("EnCueva"):Connect(actualizarPantallas)
jugador:GetAttributeChangedSignal("GeodaPresentando"):Connect(actualizarPantallas)
actualizarPantallas()

local function enCombate()
	return cueva:GetAttribute("Fase") == "Combate"
end

local ultimaOrden = -1
local function enviar(tipo)
	if not gui.Enabled then
		return
	end
	local tiempo = os.clock()
	if tiempo - ultimaOrden >= 0.12 then
		ultimaOrden = tiempo
		accion:FireServer(tipo)
	end
end

local function rafaga()
	if enCombate() and (jugador:GetAttribute("PulsoCuevaListoEn") or 0) <= workspace:GetServerTimeNow() then
		enviar("GolpeBaston")
	end
end

local function companero()
	local ahora = workspace:GetServerTimeNow()
	if enCombate() then
		if (jugador:GetAttribute("OrdenCometaListaEn") or 0) <= ahora then
			enviar("Cometa")
		end
	end
end

local function escudoRevancha()
	return jugador:GetAttribute("EnCueva") and gui.Enabled and jugador:GetAttribute("Pedernal") == true
end

local function proteger()
	local ahora = workspace:GetServerTimeNow()
	if escudoRevancha() and (jugador:GetAttribute("EscudoHasta") or 0) <= ahora
		and (not enCombate() or (jugador:GetAttribute("EscudoCombateListoEn") or 0) <= ahora) then
		enviar("Escudo")
	end
end

Controles.ataque(function() return gui.Enabled and enCombate() end, rafaga)
Controles.escudoBreve(escudoRevancha, proteger)

local function vincular(nombre, responder, disponible, ...)
	ContextActionService:BindActionAtPriority(nombre, function(_, entrada)
		if jugador:GetAttribute("EnCueva") ~= true or UserInputService:GetFocusedTextBox() then
			return Enum.ContextActionResult.Pass
		end
		if jugador:GetAttribute("GeodaPresentando") then
			return Enum.ContextActionResult.Sink
		end
		if not disponible() then
			return Enum.ContextActionResult.Pass
		end
		if entrada == Enum.UserInputState.Begin then
			responder()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, ...)
end
vincular("GeodaBaston", rafaga, enCombate, Enum.KeyCode.ButtonX)
vincular("GeodaCompanero", companero, enCombate, Enum.KeyCode.C, Enum.KeyCode.ButtonY)
vincular("GeodaEscudoRevancha", proteger, escudoRevancha, Enum.KeyCode.R, Enum.KeyCode.ButtonL1)
botonPulso.Activated:Connect(rafaga)
botonCompanero.Activated:Connect(companero)
botonEscudo.Activated:Connect(proteger)

local accionAviso
local hayAviso = false
aviso.Activated:Connect(function()
	if accionAviso then
		accionAviso()
	end
end)

local function mostrarAviso(texto, detalle, tono, teclaTexto, fn)
	accionAviso = fn
	hayAviso = true
	aviso.Interactable = fn ~= nil
	filoAviso.Color = tono
	tecla.Visible = teclaTexto ~= nil
	tecla.Text = teclaTexto or ""
	tecla.BackgroundColor3 = tono
	local margen = if teclaTexto then 70 else 13
	tituloAviso.Position = UDim2.fromOffset(margen, 6)
	tituloAviso.Size = UDim2.new(1, -margen - 10, 0, 21)
	tituloAviso.Text = texto
	tituloAviso.TextColor3 = tono
	detalleAviso.Position = UDim2.fromOffset(margen, 27)
	detalleAviso.Size = UDim2.new(1, -margen - 10, 0, 21)
	detalleAviso.Text = detalle
end

local function plano(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function raizViva()
	local personaje = jugador.Character
	local humanoide = personaje and personaje:FindFirstChildOfClass("Humanoid")
	if humanoide and humanoide.Health > 0 then
		return personaje:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

local function posiciones(root)
	local base = guardian.PrimaryPart
	if not root or not base then
		return false, false, false
	end
	local lado = plano(root.Position - base.Position)
	local frente = plano(guardian:GetPivot().LookVector)
	if frente.Magnitude > 0.1 then
		frente = frente.Unit
	end
	local espalda = lado.Magnitude <= 0.1 or frente:Dot(lado.Unit) <= LIMITE_DEL_FRENTE
	return lado.Magnitude >= DISTANCIA_COMETA_MINIMA and lado.Magnitude <= DISTANCIA_COMETA,
		(root.Position - cristal.Position).Magnitude <= DISTANCIA_CRISTAL,
		espalda
end

local transcurrido = 0
RunService.Heartbeat:Connect(function(dt)
	if not gui.Enabled then
		return
	end
	transcurrido += dt
	if transcurrido < 0.065 then
		return
	end
	transcurrido = 0
	local fase = cueva:GetAttribute("Fase") or "Inicio"
	local ataque = cueva:GetAttribute("EstadoGuardian")
	local mensaje = cueva:GetAttribute("Titulo")
	local combate = fase == "Combate"
	local pedernal = jugador:GetAttribute("Pedernal") == true
	local reloj = workspace:GetServerTimeNow()
	local listo = (jugador:GetAttribute("PulsoCuevaListoEn") or 0) <= reloj
	local aliadoListo = (jugador:GetAttribute("OrdenCometaListaEn") or 0) <= reloj
	local escudo = math.max(0, (jugador:GetAttribute("EscudoHasta") or 0) - reloj)
	local recargaEscudo = math.max(0, (jugador:GetAttribute("EscudoCombateListoEn") or 0) - reloj)
	local mando = UserInputService:GetLastInputType().Name:match("^Gamepad") ~= nil
	local tactil = UserInputService.TouchEnabled and not mando
	local disparo = if tactil then "TOCA" elseif mando then "X" else "M1"
	local aliado = if tactil then "TOCA" elseif mando then "Y" else "C"
	local teclaEscudo = if tactil then "TOCA" elseif mando then "L1" else "M2"
	local root = raizViva()
	local cometaCerca, cristalCerca, detras = posiciones(root)
	local puedeLlamar = combate and ataque == "Aviso" and cometaCerca and aliadoListo
	local haciaCristal = root and plano(cristal.Position-root.Position)
	local apuntando = haciaCristal and (haciaCristal.Magnitude < .65 or root.CFrame.LookVector:Dot(haciaCristal.Unit) >= .34)
	local puedeGolpear = combate and ataque == "Expuesto" and cristalCerca and detras and apuntando and listo
	local distanciaPuerta = root and puerta.CFrame:PointToObjectSpace(root.Position)
	local juntoViento = distanciaPuerta and math.abs(distanciaPuerta.X) <= 10
		and math.abs(distanciaPuerta.Y) <= 6 and math.abs(distanciaPuerta.Z) <= 8
	local cruzado = distanciaPuerta and distanciaPuerta.X > 4
	local vida = math.clamp(cueva:GetAttribute("VidaGuardian") or 3, 0, 3)

	guardia.Visible = combate
	objetivo.Visible = not combate
	hayAviso = false
	accionAviso = nil
	aviso.Position = if tactil then UDim2.new(0.5, 0, 1, -67) else UDim2.new(0.5, 0, 1, -49)
	marcador.Enabled = combate and ataque == "Expuesto"
	marca.TextColor3 = if puedeGolpear then MENTA else SUAVE

	for i, pieza in ipairs(cristales) do
		pieza.pieza.BackgroundColor3 = if i <= vida then ORO else PIZARRA
		pieza.filo.Color = if i <= vida then ORO else APAGADO
		pieza.filo.Transparency = if i <= vida then 0.14 else 0.54
	end

	titulo.Text = mensaje or "Cueva de la Geoda"
	pista.Text = cueva:GetAttribute("Pista") or ""
	if puedeLlamar then
		mostrarAviso("¡Llama a Cometa!", "O esquiva y haz que choque con la columna.", ORO, aliado, companero)
	elseif puedeGolpear then
		mostrarAviso("¡Golpea el cristal!", "Ahora está al alcance de tu bastón.", MENTA, disparo, rafaga)
	elseif combate and (ataque == "PrepararBarrido" or ataque == "Barrido") then
		if escudo > 0 then
			mostrarAviso("Pedernal te cubre", "El escudo bloquea la hoja de cristal.", AZUL)
		elseif pedernal and recargaEscudo <= 0 then
			mostrarAviso("¡Viene el barrido!", "Salta, rodéalo o protégete con Pedernal.", AZUL, teclaEscudo, proteger)
		else
			mostrarAviso("¡Mira el puño violeta!", "Salta la hoja cuando se acerque o ve tras él.", CORAL)
		end
	elseif combate and ataque == "Aviso" then
		mostrarAviso("¡Baja los hombros!", "Apártate de la carga o guíala hacia la columna.", CORAL)
	elseif combate and ataque == "Embestida" then
		mostrarAviso("Esquiva hacia un lado", "El guardián está embistiendo.", CORAL)
	elseif combate and ataque == "SigueACometa" then
		mostrarAviso("¡Está siguiendo a Cometa!", "Acércate a su espalda y prepara el bastón.", ORO)
	elseif combate and ataque == "Expuesto" then
		if not cristalCerca then
			mostrarAviso("Acércate al cristal", "Sigue el brillo de su espalda.", SUAVE)
		elseif not detras then
			mostrarAviso("Ve a su espalda", "Ahí está el cristal expuesto.", SUAVE)
		elseif not apuntando then
			mostrarAviso("Mira al cristal", "Gira hacia la abertura y golpea con el bastón.", SUAVE)
		else
			mostrarAviso("Prepara el bastón", "Se está recuperando del golpe.", SUAVE)
		end
	elseif combate and ataque == "Recupera" and mensaje == "¡Rompiste una capa de armadura!" then
		mostrarAviso(mensaje, ("Cristales restantes: %d"):format(vida), ORO)
	elseif combate and mensaje == "El bastón chocó con la armadura" then
		mostrarAviso("El golpe rebotó", "Distráelo o haz que golpee la columna.", SUAVE)
	elseif combate and vida == 3 and ataque == "Acecha" then
		mostrarAviso("Busca la columna agrietada", "Guía su carga hacia ella o llama a Cometa.", SUAVE)
	elseif fase == "Salida" then
		if cruzado then
			titulo.Text = if cueva:GetAttribute("SelloEncendido") then "Sello de Rebote encendido" else "Mirador de la Geoda"
			pista.Text = "Sigue el camino y enciende la baliza."
		else
			titulo.Text = "Pasadizo de viento"
			pista.Text = "Sigue la luz azul. Activa el escudo al acercarte."
		end
		if escudo > 0 then
			mostrarAviso("Escudo activo", ("Cruza el pasadizo  ·  %.1f s"):format(escudo), AZUL)
		elseif juntoViento and not cruzado and pedernal then
			mostrarAviso("Activa el escudo", "Pedernal te protege del viento.", AZUL, teclaEscudo, proteger)
		end
	end

	aviso.Visible = hayAviso
	ayuda.Visible = not tactil
	if combate then
		teclas.Text = if mando then "X Bastón · Y Cometa · A Saltar" else "M1 Bastón · C Cometa · Espacio Saltar"
		if pedernal then teclas.Text ..= if mando then " · L1 Escudo" else " · M2 Escudo" end
	elseif pedernal then
		teclas.Text = if mando then "L1 Escudo · X Interactuar" else "Clic derecho · Escudo     E · Interactuar"
	else
		teclas.Text = if mando then "X  Interactuar" else "E  Interactuar"
	end
	botonPulso.Visible = tactil and combate
	botonPulso.Text = if listo then "Golpear" else "Preparando"
	botonPulso.TextColor3 = if puedeGolpear then MENTA elseif listo then PERLA else APAGADO
	botonPulso.BackgroundColor3 = if puedeGolpear then PIZARRA else CARBON
	botonCompanero.Visible = tactil and combate
	botonCompanero.Position = UDim2.new(1, -17, 1, if combate then -175 else -124)
	botonCompanero.Text = if combate then (if aliadoListo then "Cometa" else "Recargando") else (if escudo > 0 then "Escudo activo" else "Escudo")
	botonCompanero.TextColor3 = if puedeLlamar then ORO elseif combate then PERLA else AZUL
	botonCompanero.BackgroundColor3 = if puedeLlamar or (not combate and juntoViento and not cruzado) then PIZARRA else CARBON
	botonEscudo.Visible = tactil and pedernal
	botonEscudo.Position = UDim2.new(1, -17, 1, if combate then -226 else -124)
	botonEscudo.Text = if escudo > 0 then "Escudo activo" elseif recargaEscudo > 0 then ("Escudo %.0f s"):format(math.ceil(recargaEscudo)) else "Escudo"
	botonEscudo.TextColor3 = if recargaEscudo > 0 then APAGADO else AZUL
end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{A68FBD32-9BAA-4CEA-B312-2C010C119514}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Cueva</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">760e63e6732059b00b0fee0b000004d9</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBXGeodaPresentacionInterfaz">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local jugador = Players.LocalPlayer
local cueva = workspace:WaitForChild("CuevaDeLaGeoda")
local geoda = cueva:WaitForChild("Geoda")
local ruta = cueva:WaitForChild("Ruta")
local remoto = ReplicatedStorage:WaitForChild("AccionGeoda")
local centro = geoda:WaitForChild("Centro").Position
local brillo = Color3.fromRGB(255, 211, 128)
local blanco = Color3.fromRGB(247, 248, 242)
local hielo = Color3.fromRGB(148, 218, 255)
local noche = Color3.fromRGB(14, 24, 36)
local escena

local function crear(clase, padre, props)
	local objeto = Instance.new(clase)
	for nombre, valor in pairs(props) do
		objeto[nombre] = valor
	end
	objeto.Parent = padre
	return objeto
end

local gui = crear("ScreenGui", jugador:WaitForChild("PlayerGui"), {
	Name = "GeodaPresentacionHUD",
	ResetOnSpawn = false,
	DisplayOrder = 19,
	ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
	Enabled = false,
})

local sombra = crear("Frame", gui, {
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.fromScale(0, 1),
	Size = UDim2.fromScale(1, 0.36),
	BackgroundColor3 = noche,
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
})
crear("UIGradient", sombra, {
	Rotation = 90,
	Transparency = NumberSequence.new(1, 0.1),
})

local tarjeta = crear("CanvasGroup", gui, {
	Name = "Descubrimiento",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.new(0.9, 0, 0, 93),
	BackgroundColor3 = noche,
	BackgroundTransparency = 0.04,
	GroupTransparency = 1,
})
crear("UICorner", tarjeta, { CornerRadius = UDim.new(0, 15) })
crear("UISizeConstraint", tarjeta, { MaxSize = Vector2.new(422, 93) })
local borde = crear("UIStroke", tarjeta, { Color = brillo, Transparency = 0.48 })
crear("UIGradient", tarjeta, {
	Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(202, 211, 227)),
	Rotation = 8,
})

local medalla = crear("Frame", tarjeta, {
	Position = UDim2.fromOffset(19, 31),
	Size = UDim2.fromOffset(29, 29),
	BackgroundColor3 = brillo,
	BackgroundTransparency = 0.84,
	Rotation = 45,
	BorderSizePixel = 0,
})
crear("UICorner", medalla, { CornerRadius = UDim.new(0, 5) })
local lineaMedalla = crear("UIStroke", medalla, { Thickness = 1.3, Color = brillo, Transparency = 0.18 })
crear("Frame", medalla, {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(10, 10),
	BackgroundColor3 = blanco,
	BackgroundTransparency = 0.13,
	BorderSizePixel = 0,
})

local function texto(nombre, y, tamano, fuente)
	return crear("TextLabel", tarjeta, {
		Name = nombre,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(65, y),
		Size = UDim2.new(1, -78, 0, tamano + 5),
		Font = fuente,
		TextSize = tamano,
		TextColor3 = blanco,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
end

local categoria = texto("Categoria", 11, 11, Enum.Font.GothamBold)
local nombre = texto("Nombre", 28, 27, Enum.Font.GothamBold)
local descripcion = texto("Habilidad", 63, 13, Enum.Font.GothamMedium)
descripcion.TextColor3 = Color3.fromRGB(191, 210, 224)

local saltar = crear("TextButton", gui, {
	Name = "Saltar",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -14, 0, 12),
	Size = UDim2.fromOffset(76, 44),
	BackgroundColor3 = noche,
	BackgroundTransparency = 0.19,
	Text = "Saltar",
	TextColor3 = blanco,
	TextSize = 14,
	Font = Enum.Font.GothamMedium,
})
crear("UICorner", saltar, { CornerRadius = UDim.new(0, 11) })
crear("UIStroke", saltar, { Color = blanco, Transparency = 0.75 })

local arte = crear("Folder", workspace, { Name = "EfectosLocalesGeoda" })

local function destello(padre, tono, tamano, forma)
	return crear("Part", padre, {
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		Material = Enum.Material.Neon,
		Shape = forma or Enum.PartType.Block,
		Color = tono,
		Size = tamano,
		Transparency = 1,
	})
end

local function terminar()
	if not escena then
		return
	end
	local anterior = escena
	escena = nil
	ContextActionService:UnbindAction("SaltarGeoda")
	anterior.avance:Disconnect()
	local camara = anterior.camara
	if camara and workspace.CurrentCamera == camara then
		camara.FieldOfView = anterior.fov
		camara.CFrame = anterior.marco
		camara.Focus = anterior.foco
		camara.CameraType = anterior.tipo
	end
	anterior.arte:Destroy()
	gui.Enabled = false
	jugador:SetAttribute("GeodaPresentando", false)
end

local function saltarEscena()
	if escena and escena.guardian then
		remoto:FireServer("OmitirIntroGuardian")
	end
	terminar()
end

local function abrirEscena(efectos, tono)
	local camara = if GuiService.ReducedMotionEnabled then nil else workspace.CurrentCamera
	local corte = {
		arte = efectos,
		camara = camara,
		fov = camara and camara.FieldOfView,
		marco = camara and camara.CFrame,
		foco = camara and camara.Focus,
		tipo = camara and camara.CameraType,
	}
	escena = corte
	jugador:SetAttribute("GeodaPresentando", true)
	gui.Enabled = true
	sombra.BackgroundTransparency = 1
	tarjeta.GroupTransparency = 1
	categoria.TextColor3 = tono
	borde.Color = tono
	medalla.BackgroundColor3 = tono
	lineaMedalla.Color = tono
	if camara then
		camara.CameraType = Enum.CameraType.Scriptable
	end
	ContextActionService:BindAction("SaltarGeoda", function(_, estado)
		if estado == Enum.UserInputState.Begin then
			saltarEscena()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Return, Enum.KeyCode.ButtonB)
	return corte
end

local function presentarGuardian(guardian, inicio, duracion)
	if guardian ~= cueva:FindFirstChild("Guardian") or not guardian or not guardian.PrimaryPart
		or not jugador:GetAttribute("EnCueva") or workspace:GetServerTimeNow() - inicio >= duracion then
		return
	end
	local cabeza = guardian:FindFirstChild("Cabeza")
	local cristal = guardian:FindFirstChild("CristalEspalda")
	if not cabeza or not cristal then return end
	terminar()
	local efectos = crear("Folder", arte, { Name = "DespertarGuardian" })
	local corte = abrirEscena(efectos, brillo)
	corte.guardian = true
	categoria.Text = "CUEVA DE LA GEODA"
	nombre.Text = "El Guardián"
	descripcion.Text = "Algo respira entre las rocas."
	local base = guardian.PrimaryPart.Position
	local hacia = guardian.PrimaryPart.CFrame.LookVector
	local frente = Vector3.new(hacia.X, 0, hacia.Z).Unit
	local lado = frente:Cross(Vector3.yAxis)
	local ancla = destello(efectos, brillo, Vector3.one * 0.1)
	local luz = crear("PointLight", ancla, { Color = brillo, Range = 11, Brightness = 0 })
	local veta = crear("Highlight", efectos, {
		Adornee = cristal, DepthMode = Enum.HighlightDepthMode.Occluded,
		FillColor = hielo, OutlineColor = blanco, FillTransparency = 1, OutlineTransparency = 1,
	})
	local polvo = crear("ParticleEmitter", ancla, {
		Enabled = false, Rate = 0, Texture = "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(144, 127, 112), Color3.fromRGB(113, 102, 97)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.82), NumberSequenceKeypoint.new(0.25, 0.53),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Size = NumberSequence.new(0.4, 2), Lifetime = NumberRange.new(0.45, 0.85),
		Speed = NumberRange.new(2, 5), SpreadAngle = Vector2.new(42, 42), Drag = 3,
	})
	local polvoEmitido = false
	local camara = corte.camara
	corte.avance = RunService.RenderStepped:Connect(function()
		local t = math.max(0, workspace:GetServerTimeNow() - inicio)
		local humanoide = jugador.Character and jugador.Character:FindFirstChildOfClass("Humanoid")
		if t >= duracion or not humanoide or humanoide.Health <= 0 or not jugador:GetAttribute("EnCueva")
			or (camara and workspace.CurrentCamera ~= camara) then
			terminar()
			return
		end
		local giro = math.clamp((t - 1.45) / 1.85, 0, 1)
		giro = giro * giro * (3 - 2 * giro)
		local revelar = math.clamp((t - 0.52) / 0.45, 0, 1)
		local foco = cabeza.Position:Lerp(cristal.Position, giro)
		ancla.Position = foco + frente * (1.9 - giro * 3)
		luz.Color = brillo:Lerp(hielo, giro)
		luz.Brightness = revelar * (1.4 + 0.5 * giro)
		veta.FillTransparency = 1 - giro * 0.35
		veta.OutlineTransparency = 1 - giro * 0.7
		if not polvoEmitido and t >= duracion * 0.65 then
			polvoEmitido = true
			if camara then
				ancla.Position = base + lado * 3.9 - Vector3.yAxis * 2.7
				polvo:Emit(12)
			end
		end
		if camara then
			local angulo = math.rad(20 + 139 * giro)
			local radio = 10.8 + giro * 0.8
			local ojo = base + (frente * math.cos(angulo) + lado * math.sin(angulo)) * radio
				+ Vector3.yAxis * (0.1 + giro * 3.9)
			camara.CFrame = CFrame.lookAt(ojo, foco)
			camara.Focus = CFrame.new(foco)
			camara.FieldOfView = 53 - revelar * 4 + giro * 6
		end
		if giro > 0.64 then descripcion.Text = "Una grieta de luz le recorre la espalda." end
		local opacidad = revelar * math.clamp((duracion - t) / 0.25, 0, 1)
		tarjeta.GroupTransparency = 1 - opacidad
		sombra.BackgroundTransparency = 1 - opacidad * 0.44
	end)
end

local function iniciar(inicio, mutacion, apertura, duracion)
	if not jugador:GetAttribute("EnCueva") or workspace:GetServerTimeNow() - inicio >= duracion then
		return
	end
	terminar()
	local sinMovimiento = GuiService.ReducedMotionEnabled
	local tono = if mutacion then hielo else brillo
	local efectos = crear("Folder", arte, { Name = "Revelacion" })
	local ancla = destello(efectos, tono, Vector3.new(0.1, 0.1, 0.1))
	ancla.Position = centro + Vector3.yAxis * 1.1
	local luz = crear("PointLight", ancla, { Color = tono, Range = 15, Brightness = 0 })
	local pulso = destello(efectos, tono, Vector3.one, Enum.PartType.Cylinder)
	pulso.CFrame = CFrame.new(centro.X, 20.76, centro.Z) * CFrame.Angles(0, 0, math.pi / 2)
	local fragmentos = {}
	if not sinMovimiento then
		for i = 1, 15 do
			fragmentos[i] = destello(efectos, if i % 4 == 0 then blanco else tono,
				Vector3.new(0.12 + (i % 3) * 0.06, 0.18 + (i % 4) * 0.08, 0.13))
		end
	end

	local fragmento, estela, impacto
	if mutacion then
		fragmento = destello(efectos, brillo, Vector3.new(0.31, 0.45, 0.31))
		estela = destello(efectos, tono, Vector3.one)
		impacto = destello(efectos, tono, Vector3.one, Enum.PartType.Ball)
	end

	local corte = abrirEscena(efectos, tono)
	local camara = corte.camara
	categoria.Text = if mutacion then "MUTACIÓN DESCUBIERTA" else "ECO RESCATADO"
	nombre.Text = if mutacion then "Pedernal · Rebote" else "Pedernal"
	descripcion.Text = if mutacion then "Su escudo devuelve el viento." else "Su escudo abre el pasadizo."
	corte.avance = RunService.Heartbeat:Connect(function()
		local edad = math.max(0, workspace:GetServerTimeNow() - inicio)
		local humanoide = jugador.Character and jugador.Character:FindFirstChildOfClass("Humanoid")
		if edad >= duracion or not humanoide or humanoide.Health <= 0
			or not jugador:GetAttribute("EnCueva") or (camara and workspace.CurrentCamera ~= camara) then
			terminar()
			return
		end

		local t = math.clamp((edad - apertura) / 0.86, 0, 1)
		local desenlace = math.clamp((duracion - edad) / 0.27, 0, 1)
		local textoDesde = if mutacion then 1.7 else 1.12
		local entrada = math.clamp((edad - textoDesde) / 0.3, 0, 1)
		tarjeta.GroupTransparency = 1 - entrada * desenlace
		sombra.BackgroundTransparency = 1 - entrada * desenlace * 0.57
		if camara then
			local desliz = 1 - (1 - math.clamp(edad / 2.25, 0, 1)) ^ 2
			local desde = Vector3.new(343.2, 26.8, -7)
			local hasta = Vector3.new(345.4, 26.35, -5.7)
			local objetivo = centro + Vector3.yAxis * (0.85 + t * 1.4)
			camara.CFrame = CFrame.lookAt(desde:Lerp(hasta, desliz), objetivo)
			camara.Focus = CFrame.new(objetivo)
			camara.FieldOfView = 52 - desliz * 4
		end

		local energia = if edad < apertura then edad * 3 else (1 - t) * 4
		luz.Brightness = if sinMovimiento then 0.75 else energia
		if not sinMovimiento and edad >= apertura and t < 1 then
			local diametro = 1.8 + 10.6 * t
			pulso.Size = Vector3.new(0.05, diametro, diametro)
			pulso.Transparency = 0.82 + 0.18 * t
			for i, pieza in ipairs(fragmentos) do
				local a = i * 2.4
				local avance = 1.12 + t * (2 + (i % 4) * 0.66)
				local y = 0.22 + math.sin(t * 2.75) * (1.3 + i % 5 * 0.44)
				pieza.CFrame = CFrame.new(centro + Vector3.new(math.cos(a) * avance, y, math.sin(a) * avance))
					* CFrame.Angles(a + t * 3.6, a / 2, -t * 4)
				pieza.Transparency = math.clamp(t * 1.25, 0, 1)
			end
		else
			pulso.Transparency = 1
			for _, pieza in ipairs(fragmentos) do
				pieza.Transparency = 1
			end
		end

		if fragmento and estela and impacto then
			local punto = centro + Vector3.new(-0.85, 2.67, -0.7)
			local llegada = centro + Vector3.new(-4, 4.2, 0.75)
			local salida = centro + Vector3.new(-0.22, 4.4, -3.6)
			local golpe = edad - 1.43
			local vuelo = math.clamp((edad - 1.12) / 0.31, 0, 1)
			local regreso = math.clamp(golpe / 0.44, 0, 1)
			local hacia = if golpe < 0 then punto else salida
			local pos = if golpe < 0 then llegada:Lerp(punto, vuelo) else punto:Lerp(salida, regreso)
			local anterior = if golpe < 0 then llegada:Lerp(punto, math.max(0, vuelo - 0.22))
				else punto:Lerp(salida, math.max(0, regreso - 0.22))
			local mostrando = not sinMovimiento and edad > 1.13 and edad < 1.87
			fragmento.CFrame = CFrame.lookAt(pos, if (hacia - pos).Magnitude > 0.005 then hacia else pos + Vector3.zAxis)
				* CFrame.Angles(0, math.rad(36), edad * 8)
			fragmento.Color = if golpe < 0 then brillo else tono
			fragmento.Transparency = if mostrando then 0.05 else 1
			local distancia = (pos - anterior).Magnitude
			if mostrando and distancia > 0.025 then
				estela.Size = Vector3.new(0.11, 0.11, distancia)
				estela.CFrame = CFrame.lookAt((pos + anterior) / 2, pos)
			end
			estela.Transparency = if mostrando and distancia > 0.025 then 0.28 else 1
			local radio = math.clamp(golpe / 0.34, 0, 1)
			impacto.Position = punto
			impacto.Size = Vector3.one * (0.32 + radio * 2.2)
			impacto.Transparency = if not sinMovimiento and golpe >= 0 and radio < 1 then 0.5 + radio * 0.5 else 1
		end
	end)
end

remoto.OnClientEvent:Connect(function(evento, a, b, c, d)
	if evento == "Revelacion" then
		iniciar(a, b, c, d)
	elseif evento == "IntroduccionGuardian" then
		presentarGuardian(a, b, c)
	end
end)
saltar.Activated:Connect(saltarEscena)
cueva:GetAttributeChangedSignal("Fase"):Connect(function()
	if escena and escena.guardian and cueva:GetAttribute("Fase") ~= "Presentacion" then terminar() end
end)
jugador.CharacterRemoving:Connect(terminar)

local guia = crear("Folder", arte, { Name = "CorrienteDelMirador" })
local pasos = {
	{ Vector3.new(350.6, 20.16, 4.65), Vector3.new(0.44, 0, 1) },
	{ Vector3.new(352.2, 20.16, 8.2), Vector3.new(0.8, 0, 1) },
	{ Vector3.new(355.4, 20.16, 11.25), Vector3.new(1, 0, 0.57) },
	{ Vector3.new(359.4, 20.16, 13), Vector3.xAxis },
	{ Vector3.new(363, 20.16, 13), Vector3.xAxis },
	{ Vector3.new(370.1, 20.16, 13), Vector3.xAxis },
	{ Vector3.new(378.5, 20.16, 13), Vector3.xAxis },
}
local marcas = {}
for i, paso in ipairs(pasos) do
	local marco = CFrame.lookAt(paso[1], paso[1] + paso[2])
	for _, lado in ipairs({ -1, 1 }) do
		local trazo = destello(guia, hielo, Vector3.new(0.16, 0.043, 0.78))
		trazo.CFrame = marco * CFrame.new(lado * 0.23, 0, 0) * CFrame.Angles(0, lado * math.rad(39), 0)
		marcas[#marcas + 1] = { pieza = trazo, paso = i }
	end
end
local hebras = {}
for i = 1, 12 do
	hebras[i] = destello(guia, hielo, Vector3.new(0.72 + (i % 3) * 0.33, 0.055, 0.055))
end

local guiando = false
local function guiar()
	local fase = cueva:GetAttribute("Fase")
	local mostrar = jugador:GetAttribute("EnCueva") and fase == "Salida" and not escena
	if not mostrar and not guiando then
		return
	end
	guiando = mostrar == true
	local t = workspace:GetServerTimeNow()
	local quieto = GuiService.ReducedMotionEnabled
	for _, marca in ipairs(marcas) do
		marca.pieza.Transparency = if not mostrar then 1 elseif quieto then 0.34
			else 0.36 + math.sin(t * 3.2 - marca.paso * 1.1) * 0.2
	end
	for i, hebra in ipairs(hebras) do
		local progreso = (t * 0.18 + i * 0.194) % 1
		if mostrar and not quieto then
			local z = if i % 2 == 0 then 8.1 else 17.9
			local y = 20.65 + (i % 3) * 0.72
			local x = 356.4 + progreso * (ruta.Baliza.Position.X - 356.4)
			hebra.Position = Vector3.new(x, y, z + math.sin(t * 1.4 + i) * 0.39)
			hebra.Transparency = 0.42 + 0.58 * math.abs(progreso * 2 - 1)
		else
			hebra.Transparency = 1
		end
	end
end

while task.wait(1 / 30) do
	guiar()
end]]></ProtectedString>
