				<token name="RunContext">0</token>
				<string name="ScriptGuid">{80BC5045-9448-4389-B064-123BEA916CE3}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Progreso</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">16d01229428087e30b10072b000005ca</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXVersionMolinoModuleScriptProgresoDatos">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local ProgresoDatos = {}

ProgresoDatos.PrecioMejoraPedernal = 60
ProgresoDatos.PrecioPlaneadorAvanzado = 65

ProgresoDatos.Claves = table.freeze({
	"Cometa",
	"VigiasDerrotados",
	"Vendaval",
	"Refugio",
	"Cornisa",
	"Pedernal",
	"Rebote",
	"TesoroRevelado",
	"MiradorGeoda",
	"SelloGeoda",
	"MolinoVista",
	"Lucero",
	"MejoraPedernal",
	"EncargoPedernal",
	"PlaneadorAvanzado",
	"LenteGeoda",
	"ConsejoGeoda",
	"ConsejoLente",
	"FaroEncendido",
	"Prisma",
	"Nimbo",
	"NimboAurora",
})

local premios = {
	Cometa = { 40, 20 },
	Pedernal = { 50, 30 },
	Lucero = { 70, 50 },
	Vendaval = { 20, 10 },
	Rebote = { 30, 15 },
	FaroEncendido = { 65, 45 },
	Prisma = { 35, 20 },
}

local XP_NIVEL_DOS = 100
local XP_ENCARGO = 40
local MONEDAS_ENCARGO = 25

local function gananciasDeExpedicion(datos)
	local experiencia, monedas = 0, 0
	for nombre, premio in pairs(premios) do
		if datos[nombre] then
			experiencia += premio[1]
			monedas += premio[2]
		end
	end
	return experiencia, monedas
end

local function normalizar(datos, conservarPlaneador)
	local limpio = {}
	for _, nombre in ipairs(ProgresoDatos.Claves) do
		limpio[nombre] = type(datos) == "table" and datos[nombre] == true
	end

	-- Una recompensa del final de la ruta también prueba sus pasos previos.
	limpio.Nimbo = limpio.Nimbo or limpio.NimboAurora
	limpio.Prisma = limpio.Prisma or limpio.Nimbo
	limpio.LenteGeoda = limpio.LenteGeoda or limpio.Prisma
	limpio.FaroEncendido = limpio.FaroEncendido or limpio.Prisma
	limpio.Lucero = limpio.Lucero or limpio.FaroEncendido
	limpio.Vendaval = limpio.Vendaval or limpio.Cornisa
	limpio.Rebote = limpio.Rebote or limpio.SelloGeoda
	limpio.Pedernal = limpio.Pedernal or limpio.Rebote or limpio.TesoroRevelado
		or limpio.MiradorGeoda or limpio.Lucero or limpio.LenteGeoda
	limpio.Cometa = limpio.Cometa or limpio.Vendaval or limpio.Refugio or limpio.Lucero
	limpio.VigiasDerrotados = limpio.VigiasDerrotados or limpio.Cometa
	limpio.TesoroRevelado = limpio.Pedernal
	limpio.MolinoVista = limpio.MolinoVista or limpio.Lucero
	-- El encargo prueba la compra, pero su propio premio no puede financiarla.
	local experiencia, monedas = gananciasDeExpedicion(limpio)
	if limpio.MejoraPedernal or limpio.EncargoPedernal then
		limpio.MejoraPedernal = limpio.Pedernal and experiencia >= XP_NIVEL_DOS
			and monedas >= ProgresoDatos.PrecioMejoraPedernal
		limpio.EncargoPedernal = limpio.EncargoPedernal and limpio.MejoraPedernal
	end
	if limpio.PlaneadorAvanzado then
		local saldo = monedas + (if limpio.EncargoPedernal then MONEDAS_ENCARGO else 0)
			- (if limpio.MejoraPedernal then ProgresoDatos.PrecioMejoraPedernal else 0)
		if not limpio.Cometa or saldo < ProgresoDatos.PrecioPlaneadorAvanzado then
			-- Una escritura de premios no desplaza un recibo confirmado en el almacén.
			if conservarPlaneador and limpio.Cometa and monedas >= ProgresoDatos.PrecioPlaneadorAvanzado then
				limpio.MejoraPedernal = false
				limpio.EncargoPedernal = false
			else
				limpio.PlaneadorAvanzado = false
			end
		end
	end
	return limpio
end

function ProgresoDatos.Normalizar(datos)
	return normalizar(datos, false)
end

function ProgresoDatos.Calcular(datos)
	local limpio = ProgresoDatos.Normalizar(datos)
	local experiencia, monedas = gananciasDeExpedicion(limpio)
	if limpio.EncargoPedernal then
		experiencia += XP_ENCARGO
		monedas += MONEDAS_ENCARGO
	end
	if limpio.MejoraPedernal then
		monedas -= ProgresoDatos.PrecioMejoraPedernal
	end
	if limpio.PlaneadorAvanzado then
		monedas -= ProgresoDatos.PrecioPlaneadorAvanzado
	end

	-- El nivel 2 requiere 100 XP totales. Cada tramo siguiente cuesta 20 XP más.
	local nivel, xpNivel, xpMeta = 1, experiencia, XP_NIVEL_DOS
	while xpNivel >= xpMeta do
		xpNivel -= xpMeta
		nivel += 1
		xpMeta += 20
	end
	return {
		Nivel = nivel,
		Experiencia = experiencia,
		Monedas = monedas,
		XpNivel = xpNivel,
		XpMeta = xpMeta,
	}
end

function ProgresoDatos.PuedeComprarPedernal(datos)
	local limpio = ProgresoDatos.Normalizar(datos)
	if limpio.MejoraPedernal then
		return false, "YaComprada"
	end
	if not limpio.Pedernal then
		return false, "FaltaPedernal"
	end
	local estado = ProgresoDatos.Calcular(limpio)
	if estado.Nivel < 2 then
		return false, "FaltaNivel"
	end
	if estado.Monedas < ProgresoDatos.PrecioMejoraPedernal then
		return false, "MonedasInsuficientes"
	end
	return true, "Comprada"
end

function ProgresoDatos.PuedeComprarPlaneador(datos)
	local limpio = ProgresoDatos.Normalizar(datos)
	if limpio.PlaneadorAvanzado then
		return false, "YaComprada"
	end
	if not limpio.Cometa then
		return false, "FaltaCometa"
	end
	if ProgresoDatos.Calcular(limpio).Monedas < ProgresoDatos.PrecioPlaneadorAvanzado then
		return false, "MonedasInsuficientes"
	end
	return true, "Comprada"
end

function ProgresoDatos.RecargaEscudo(datos)
	return if type(datos) == "table" and datos.MejoraPedernal == true then 2.65 else 3.95
end

function ProgresoDatos.Fusionar(anterior, ganado)
	if anterior ~= nil and type(anterior) ~= "table" then
		return nil
	end

	local guardado = ProgresoDatos.Normalizar(anterior)
	local conservado = if anterior then table.clone(anterior) else {}
	for _, nombre in ipairs(ProgresoDatos.Claves) do
		conservado[nombre] = conservado[nombre] == true or (type(ganado) == "table" and ganado[nombre] == true)
	end
	for nombre, obtenido in pairs(normalizar(conservado, guardado.PlaneadorAvanzado)) do
		conservado[nombre] = obtenido
	end
	-- Los recibos antiguos equipaban el avanzado automáticamente. Una compra nueva
	-- parte del básico y solo una elección explícita puede cambiarlo.
	local eleccion = if anterior then anterior.PlaneadorEquipado else nil
	local usaAvanzado = eleccion == "Avanzado" or (eleccion == nil and guardado.PlaneadorAvanzado)
	conservado.PlaneadorEquipado = if usaAvanzado and conservado.PlaneadorAvanzado then "Avanzado" else "Basico"
	local revision = conservado.RevisionEquipo
	conservado.RevisionEquipo = if type(revision) == "number" and revision >= 0 and revision < math.huge
		then math.floor(revision) else 0
	local version = conservado.Version
	conservado.Version = if type(version) == "number" and version >= 3 then version else 3
	return conservado
end

local function actualizar(almacen, clave, transformar)
	local ok, resultado = pcall(function()
		return almacen:UpdateAsync(clave, function(anterior, informacionClave)
			local cambiado = transformar(anterior)
			if cambiado and informacionClave then
				return cambiado, informacionClave:GetUserIds(), informacionClave:GetMetadata()
			end
			return cambiado
		end)
	end)
	if ok and type(resultado) == "table" then
		return resultado
	end
	return nil, if ok then "El perfil antiguo tiene un formato desconocido." else resultado
end

function ProgresoDatos.Escribir(almacen, clave, ganado)
	return actualizar(almacen, clave, function(anterior)
		return ProgresoDatos.Fusionar(anterior, ganado)
	end)
end

local validadores = {
	MejoraPedernal = ProgresoDatos.PuedeComprarPedernal,
	PlaneadorAvanzado = ProgresoDatos.PuedeComprarPlaneador,
}

function ProgresoDatos.Comprar(almacen, clave, ganado, producto)
	local validar = assert(validadores[producto], "Producto desconocido")
	local motivo
	local perfil, fallo = actualizar(almacen, clave, function(anterior)
		local cambiado = ProgresoDatos.Fusionar(anterior, ganado)
		if not cambiado then
			return nil
		end
		-- UpdateAsync puede repetir la validación si otro servidor escribe primero.
		local permitido, causa = validar(cambiado)
		motivo = causa
		if permitido then
			cambiado[producto] = true
		end
		return cambiado
	end)
	if not perfil then
		return nil, fallo
	end
	return perfil, motivo
end

function ProgresoDatos.PuedeEquipar(perfil, eleccion)
	if eleccion ~= "Basico" and eleccion ~= "Avanzado" then
		return false, "PlaneadorDesconocido"
	end
	if not perfil.Cometa then
		return false, "FaltaCometa"
	end
	if eleccion == "Avanzado" and not perfil.PlaneadorAvanzado then
		return false, "FaltaPlaneador"
	end
	return true, "Equipado"
end

function ProgresoDatos.Equipar(almacen, clave, ganado, eleccion)
	local motivo
	local perfil, fallo = actualizar(almacen, clave, function(anterior)
		local cambiado = ProgresoDatos.Fusionar(anterior, ganado)
		if not cambiado then
			return nil
		end
		local permitido, causa = ProgresoDatos.PuedeEquipar(cambiado, eleccion)
		motivo = causa
		if permitido and cambiado.PlaneadorEquipado ~= eleccion then
			cambiado.PlaneadorEquipado = eleccion
			cambiado.RevisionEquipo += 1
		end
		return cambiado
	end)
	return perfil, if perfil then motivo else fallo
end

function ProgresoDatos.Memoria()
	local perfiles = {}
	local memoria = {}

	function memoria:GetAsync(clave)
		local perfil = perfiles[clave]
		return if perfil then table.clone(perfil) else nil
	end

	function memoria:UpdateAsync(clave, actualizar)
		local cambiado = actualizar(self:GetAsync(clave))
		if cambiado then
			perfiles[clave] = table.clone(cambiado)
		end
		return cambiado
	end

	return memoria
end

return ProgresoDatos]]></ProtectedString>
				<string name="ScriptGuid">{AAC9E727-BAC5-4F66-BC26-0272D3989CFC}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ProgresoDatos</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">16d01229428087e30b10072b000005cb</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXVersionRefugioScriptRefugio">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local datos = require(ServerScriptService:WaitForChild("ProgresoDatos"))
local comprar = ServerScriptService:WaitForChild("ComprarMejoraRefugio")
local comprarPlaneador = ServerScriptService:WaitForChild("ComprarPlaneadorRefugio")
local equiparPlaneador = ServerScriptService:WaitForChild("EquiparPlaneadorRefugio")
local remoto = ReplicatedStorage:WaitForChild("AccionRefugio")
local isla = workspace:WaitForChild("IslaDelViento")
local refugio = isla:WaitForChild("RefugioDelViento")
local puntoFarero = refugio:WaitForChild("PuntoFarero")
local zona = refugio:WaitForChild("ZonaEncargo")
local primera = refugio:WaitForChild("ZonaRafaga1")
local segunda = refugio:WaitForChild("ZonaRafaga2")
local vientoVisual = require(ServerScriptService:WaitForChild("VientoVisual"))

local ESPERA_RELEVO = 7
local DURACION_ESCUDO = 2.35
local BARRERA = Color3.fromRGB(130, 207, 255)
local encargos = {}

local function ahora()
	return workspace:GetServerTimeNow()
end

local function crearPrompt(pieza, objeto, accion, alcance)
	local p = Instance.new("ProximityPrompt")
	p.Name = "Accion"
	p.ObjectText = objeto
	p.ActionText = accion
	p.MaxActivationDistance = alcance
	p.RequiresLineOfSight = false
	p.ClickablePrompt = true
	p.Parent = pieza
	return p
end

local hablar = crearPrompt(puntoFarero, "Farero del viento", "Hablar", 8.25)
local inicio = crearPrompt(refugio:WaitForChild("InicioEncargo"), "Relevo de los faroles", "Aceptar encargo", 6.4)
local meta = crearPrompt(refugio:WaitForChild("MetaEncargo"), "Relevo de los faroles", "Entregar encargo", 6.8)
inicio.Enabled = false
meta.Enabled = false

local function raiz(jugador)
	local personaje = jugador.Character
	local h = personaje and personaje:FindFirstChildOfClass("Humanoid")
	if h and h.Health > 0 then
		return personaje:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

local function enIsla(jugador)
	return not jugador:GetAttribute("EnCueva") and not jugador:GetAttribute("EnMolino")
		and not jugador:GetAttribute("EnFaro")
		and jugador:GetAttribute("FaseNido") ~= "Defensa"
end

local function alAlcance(jugador, p)
	local root = raiz(jugador)
	return enIsla(jugador) and root and (root.Position - p.Parent.Position).Magnitude <= p.MaxActivationDistance + 0.65
end

local function dentro(pieza, posicion, margen)
	local d = pieza.CFrame:PointToObjectSpace(posicion)
	local mitad = pieza.Size * 0.5
	return math.abs(d.X) <= mitad.X + margen and math.abs(d.Y) <= mitad.Y + margen
		and math.abs(d.Z) <= mitad.Z + margen
end

local function limpiar(jugador)
	local encargo = encargos[jugador]
	if encargo and encargo.escudo then
		encargo.escudo:Destroy()
	end
	encargos[jugador] = nil
	jugador:SetAttribute("EnEncargoPedernal", false)
	jugador:SetAttribute("EstadoEncargo", "")
	jugador:SetAttribute("EscudoRefugioHasta", 0)
	jugador:SetAttribute("EscudoRefugioListoEn", 0)
	jugador:SetAttribute("EncargoHasta", 0)
end

local function estado(jugador, encargo, siguiente)
	encargo.fase = siguiente
	jugador:SetAttribute("EstadoEncargo", siguiente)
end

local function puedeAceptar(jugador)
	return jugador:GetAttribute("ProgresoListo") == true and jugador:GetAttribute("MejoraPedernal") == true
		and not jugador:GetAttribute("EncargoPedernal")
end

hablar.Triggered:Connect(function(jugador)
	if alAlcance(jugador, hablar) then
		if jugador:GetAttribute("ProgresoListo") then
			if jugador:GetAttribute("Lucero") then
				jugador:SetAttribute("ConsejoLente", true)
			elseif jugador:GetAttribute("Cometa") and jugador:GetAttribute("Refugio") then
				jugador:SetAttribute("ConsejoGeoda", true)
			end
		end
		remoto:FireClient(jugador, "AbrirTienda")
	end
end)

inicio.Triggered:Connect(function(jugador)
	if encargos[jugador] or not puedeAceptar(jugador) or not alAlcance(jugador, inicio) then
		return
	end
	local encargo = { escudoHasta = 0, recarga = 0, hasta = 0, avatar = jugador.Character }
	encargos[jugador] = encargo
	estado(jugador, encargo, "Primero")
	jugador:SetAttribute("EnEncargoPedernal", true)
end)

meta.Triggered:Connect(function(jugador)
	local encargo = encargos[jugador]
	if not encargo or encargo.fase ~= "Meta" or not alAlcance(jugador, meta) then
		return
	end
	limpiar(jugador)
	jugador:SetAttribute("EncargoPedernal", true)
	remoto:FireClient(jugador, "EncargoCompleto")
end)

local function burbuja(root)
	local p = Instance.new("Part")
	p.Name = "EscudoDelRelevo"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(6.5, 6.5, 6.5)
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Transparency = 0.86
	p.Color = BARRERA
	p.Material = Enum.Material.ForceField
	p.Position = root.Position
	p.Parent = refugio
	return p
end

local function activarEscudo(jugador)
	local encargo = encargos[jugador]
	local root = raiz(jugador)
	if not encargo or not root or not enIsla(jugador) or not puedeAceptar(jugador) then
		return
	end
	local t = ahora()
	if t < encargo.recarga then
		return
	end
	if encargo.fase == "Segundo" or encargo.fase == "Reintentar" then
		if (encargo.fase=="Segundo" and t > encargo.hasta) or not dentro(segunda, root.Position, 0.32) then
			return
		end
		estado(jugador, encargo, "Meta")
		jugador:SetAttribute("EncargoHasta", 0)
	elseif encargo.fase == "Primero"
		and dentro(primera, root.Position, 0.32) then
		encargo.hasta = t + ESPERA_RELEVO
		jugador:SetAttribute("EncargoHasta", encargo.hasta)
		estado(jugador, encargo, "Segundo")
	else
		return
	end
	encargo.escudoHasta = t + DURACION_ESCUDO
	encargo.recarga = t + datos.RecargaEscudo({ MejoraPedernal = true })
	jugador:SetAttribute("EscudoRefugioHasta", encargo.escudoHasta)
	jugador:SetAttribute("EscudoRefugioListoEn", encargo.recarga)
	if not encargo.escudo then
		encargo.escudo = burbuja(root)
		vientoVisual.escudo(encargo.escudo)
	end
	vientoVisual.impacto(root.Position, -Vector3.zAxis, "Bloqueo", refugio)
end

local function confirmarCompra(jugador, servicio, evento, numero)
	if not alAlcance(jugador, hablar) then
		remoto:FireClient(jugador, evento, false, "Lejos", nil, numero)
		return
	end
	local ok, codigo = servicio:Invoke(jugador)
	if jugador.Parent == Players then
		remoto:FireClient(jugador, evento, ok, codigo, nil, numero)
	end
end

local function prepararSalidaAlFaro(jugador)
	local destino = isla:FindFirstChild("RuinasDelFaro")
	local salida = destino and destino:FindFirstChild("Despegue")
	local root = raiz(jugador)
	if not root or not salida or not alAlcance(jugador, hablar) or jugador:GetAttribute("EnEncargoPedernal") then
		remoto:FireClient(jugador, "SalidaAlFaro", false, "Lejos")
		return
	end
	if not jugador:GetAttribute("Lucero") then
		remoto:FireClient(jugador, "SalidaAlFaro", false, "FaltaLucero")
		return
	end
	if (jugador:GetAttribute("Nivel") or 1) < 2 then
		remoto:FireClient(jugador, "SalidaAlFaro", false, "FaltaNivel")
		return
	end
	if not jugador:GetAttribute("LenteGeoda") then
		remoto:FireClient(jugador, "SalidaAlFaro", false, "FaltaLente")
		return
	end
	local desde = Vector3.new(salida.Position.X, 23.65, salida.Position.Z)
	jugador.Character:PivotTo(CFrame.lookAt(desde, desde + Vector3.zAxis))
	root.AssemblyLinearVelocity = Vector3.zero
	remoto:FireClient(jugador, "SalidaAlFaro", true, "Preparada")
end

remoto.OnServerEvent:Connect(function(jugador, mensaje, numero)
	numero = if type(numero) == "number" and numero > 0 and numero < 2^53 then numero else nil
	if mensaje == "ComprarPedernal" then
		confirmarCompra(jugador, comprar, "ResultadoCompra", numero)
	elseif mensaje == "ComprarPlaneador" then
		confirmarCompra(jugador, comprarPlaneador, "ResultadoPlaneador", numero)
	elseif mensaje == "EquiparBasico" or mensaje == "EquiparAvanzado" then
		local eleccion = if mensaje == "EquiparBasico" then "Basico" else "Avanzado"
		local ok, codigo = equiparPlaneador:Invoke(jugador, eleccion)
		if jugador.Parent == Players then
			remoto:FireClient(jugador, "ResultadoEquipo", ok, codigo, mensaje, numero)
		end
	elseif mensaje == "PrepararFaro" then
		prepararSalidaAlFaro(jugador)
	elseif mensaje == "Escudo" then
		activarEscudo(jugador)
	end
end)

if RunService:IsStudio() and game.GameId == 0 and isla:GetAttribute("AtajosDePrueba") == true then
	local p = Instance.new("Part")
	p.Name = "PruebaDelRefugio"
	p.Size = Vector3.new(1.57, 1.78, 1.57)
	p.Color = Color3.fromRGB(128, 255, 207)
	p.Material = Enum.Material.Neon
	p.CFrame = CFrame.new(-53.6, 22.2, 8.25) * CFrame.Angles(0.32, 0, 0.43)
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.Parent = isla
	local prueba = crearPrompt(p, "Refugio del Viento", "Probar nivel y tienda", 7)
	prueba.Triggered:Connect(function(jugador)
		local root = raiz(jugador)
		if not root or not alAlcance(jugador, prueba) or not jugador:GetAttribute("ProgresoListo") then
			return
		end
		for _, premio in ipairs({ "Cometa", "Pedernal", "MolinoVista", "Lucero", "Refugio" }) do
			jugador:SetAttribute(premio, true)
		end
		local posicion = Vector3.new(82.4, 23.65, 3.1)
		local frente = Vector3.new(puntoFarero.Position.X, posicion.Y, puntoFarero.Position.Z)
		jugador.Character:PivotTo(CFrame.lookAt(posicion, frente))
		root.AssemblyLinearVelocity = Vector3.zero
	end)
end

Players.PlayerRemoving:Connect(limpiar)
inicio.Enabled, meta.Enabled = true, true
while task.wait(0.07) do
	local t = ahora()
	for _, jugador in ipairs(Players:GetPlayers()) do
		local encargo = encargos[jugador]
		if encargo then
			local root = raiz(jugador)
			if not root or jugador.Character ~= encargo.avatar or not enIsla(jugador)
				or not dentro(zona, root.Position, 8.2) then
				limpiar(jugador)
			else
				if encargo.fase == "Segundo" and t >= encargo.hasta then
					estado(jugador, encargo, "Reintentar")
					jugador:SetAttribute("EncargoHasta", 0)
				end
				if encargo.escudo then
					if t < encargo.escudoHasta then
						encargo.escudo.Position = root.Position
					else
						encargo.escudo:Destroy()
						encargo.escudo = nil
					end
				end
			end
		end
	end
end]]></ProtectedString>
				<bool name="Disabled">false</bool>
