		</Item>
		<Item class="Script" referent="RBXVersionMolinoScriptProgreso">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Datos = require(script.Parent:WaitForChild("ProgresoDatos"))
local NOMBRE_ALMACEN = "CazadoresDeEcos_Progreso"
local ESPERA_GUARDADO = 3
local ESPERA_REINTENTO = 22

local enStudio = RunService:IsStudio()
local enExperienciaPublicada = game.GameId > 0 and game.PlaceId > 0
local permiteNube = enExperienciaPublicada and (not enStudio or script:GetAttribute("PermitirNubeEnStudio") == true)
local nube
if permiteNube then
	-- Una prueba de Studio con API habilitada usa un ámbito separado.
	local alcance = if enStudio then "pruebasStudio" else "jugadores"
	local ok, almacen = pcall(DataStoreService.GetDataStore, DataStoreService, NOMBRE_ALMACEN, alcance)
	if ok then
		nube = almacen
	else
		warn("[Cazadores de Ecos] El almacén no está disponible. El progreso dura esta partida.")
	end
end

local memoria = Datos.Memoria()
local sesiones = {}

local function indicar(ficha, estado)
	if ficha.jugador.Parent == Players then
		ficha.jugador:SetAttribute("EstadoGuardado", if ficha.nube then estado else "Sesion")
	end
end

local function publicarEconomia(ficha)
	local jugador = ficha.jugador
	if jugador.Parent ~= Players then
		return
	end
	for atributo, valor in pairs(Datos.Calcular(ficha.avance)) do
		jugador:SetAttribute(atributo, valor)
	end
end

local function aplicar(ficha, datos)
	local combinado = Datos.Fusionar(datos, ficha.avance)
	local cambioVisible = false
	for _, atributo in ipairs(Datos.Claves) do
		if combinado[atributo] then
			ficha.avance[atributo] = true
			if ficha.jugador.Parent == Players and ficha.jugador:GetAttribute(atributo) ~= true then
				ficha.jugador:SetAttribute(atributo, true)
				cambioVisible = true
			end
		end
	end
	publicarEconomia(ficha)
	if cambioVisible and ficha.jugador.Parent == Players then
		local revision = ficha.jugador:GetAttribute("ProgresoRevision") or 0
		ficha.jugador:SetAttribute("ProgresoRevision", revision + 1)
	end
end

local function guardar(ficha, intentos)
	if ficha.guardando or ficha.revision == ficha.guardada then
		return
	end

	ficha.guardando = true
	local revision = ficha.revision
	local datos = table.clone(ficha.avance)
	local guardado, fallo
	for intento = 1, intentos do
		guardado, fallo = Datos.Escribir(ficha.almacen, ficha.clave, datos)
		if guardado then
			break
		end
		if intento < intentos then
			task.wait(intento * 0.7)
		end
	end

	if guardado then
		ficha.guardada = revision
		ficha.cargaConfirmada = true
		aplicar(ficha, guardado)
		indicar(ficha, if ficha.guardada == ficha.revision then "Guardado" else "SinGuardar")
	else
		indicar(ficha, "Reintentando")
		warn("[Cazadores de Ecos] Falló el guardado del progreso:", fallo)
	end
	ficha.guardando = false
end

local function programarGuardado(ficha, demora)
	if ficha.programada or ficha.cerrando or not ficha.lista or ficha.revision == ficha.guardada then
		return
	end

	ficha.programada = true
	task.delay(demora, function()
		if ficha.cerrando then
			return
		end
		guardar(ficha, 3)
		ficha.programada = false
		local espera = if ficha.jugador:GetAttribute("EstadoGuardado") == "Reintentando"
			then ESPERA_REINTENTO else ESPERA_GUARDADO
		programarGuardado(ficha, espera)
	end)
end

local function anotarCambio(ficha)
	publicarEconomia(ficha)
	indicar(ficha, "SinGuardar")
	programarGuardado(ficha, ESPERA_GUARDADO)
end

local function cargar(ficha)
	local ok, datos
	for intento = 1, 3 do
		if ficha.cerrando then
			return
		end
		ok, datos = pcall(ficha.almacen.GetAsync, ficha.almacen, ficha.clave)
		if ok and (datos == nil or type(datos) == "table") then
			break
		end
		ok = false
		if intento < 3 then
			task.wait(intento * 0.7)
		end
	end

	if ficha.cerrando or ficha.jugador.Parent ~= Players or (ficha.cargaConfirmada and not ok) then
		return
	end
	if ok then
		ficha.cargaConfirmada = true
		aplicar(ficha, datos)
		indicar(ficha, if ficha.revision == ficha.guardada then "Guardado" else "SinGuardar")
	else
		indicar(ficha, "Reintentando")
		task.delay(ESPERA_REINTENTO, function()
			if not ficha.cerrando and not ficha.cargaConfirmada then
				cargar(ficha)
			end
		end)
	end

	ficha.lista = true
	ficha.jugador:SetAttribute("ProgresoListo", true)
	programarGuardado(ficha, ESPERA_GUARDADO)
end

local function capturar(ficha, nombre)
	if nombre == "MejoraPedernal" or (nombre == "EncargoPedernal" and not ficha.avance.MejoraPedernal) then
		return false
	end
	if ficha.avance[nombre] or ficha.jugador:GetAttribute(nombre) ~= true then
		return false
	end
	ficha.avance[nombre] = true
	ficha.revision += 1
	return true
end

local function recibir(jugador)
	if sesiones[jugador] or jugador.Parent ~= Players then
		return
	end

	local almacen = if nube and jugador.UserId > 0 then nube else memoria
	local ficha = {
		jugador = jugador,
		almacen = almacen,
		nube = almacen == nube,
		clave = "jugador:" .. jugador.UserId,
		avance = {},
		observadores = {},
		revision = 0,
		guardada = 0,
	}
	sesiones[jugador] = ficha
	jugador:SetAttribute("ModoGuardado", if ficha.nube then "Nube" else "Sesion")
	jugador:SetAttribute("ProgresoListo", false)
	jugador:SetAttribute("ProgresoRevision", 0)
	indicar(ficha, "Cargando")

	for _, nombre in ipairs(Datos.Claves) do
		if jugador:GetAttribute(nombre) == nil then
			jugador:SetAttribute(nombre, false)
		end
		local function anotar()
			if ficha.cerrando or not capturar(ficha, nombre) then
				return
			end
			anotarCambio(ficha)
		end
		table.insert(ficha.observadores, jugador:GetAttributeChangedSignal(nombre):Connect(anotar))
		anotar()
	end
	publicarEconomia(ficha)
	task.spawn(cargar, ficha)
end

local compraRefugio = Instance.new("BindableFunction")
compraRefugio.Name = "ComprarMejoraRefugio"
compraRefugio.OnInvoke = function(jugador)
	local ficha = sesiones[jugador]
	if not ficha or not ficha.lista or ficha.cerrando or ficha.jugador.Parent ~= Players then
		return false, "ProgresoNoListo"
	end

	local progresoNuevo = false
	for _, nombre in ipairs(Datos.Claves) do
		if capturar(ficha, nombre) then
			progresoNuevo = true
		end
	end
	local comprada, motivo = Datos.PuedeComprarPedernal(ficha.avance)
	if comprada then
		-- La propiedad es un recibo único. Los servidores descuentan el mismo
		-- precio de ese recibo al fusionar, aunque ambos intenten la compra.
		ficha.avance.MejoraPedernal = true
		ficha.revision += 1
		jugador:SetAttribute("MejoraPedernal", true)
	end
	if progresoNuevo or comprada then
		anotarCambio(ficha)
	end
	return comprada, motivo
end
compraRefugio.Parent = script.Parent

local function cerrar(ficha, limite)
	if ficha.cerrando then
		return
	end
	ficha.cerrando = true
	for _, nombre in ipairs(Datos.Claves) do
		capturar(ficha, nombre)
	end
	for _, conexion in ipairs(ficha.observadores) do
		conexion:Disconnect()
	end

	while ficha.guardando and os.clock() < limite do
		task.wait()
	end
	if os.clock() < limite then
		guardar(ficha, 2)
	end
	sesiones[ficha.jugador] = nil
end

Players.PlayerAdded:Connect(recibir)
Players.PlayerRemoving:Connect(function(jugador)
	local ficha = sesiones[jugador]
	if ficha then
		cerrar(ficha, os.clock() + 12)
	end
end)
for _, jugador in ipairs(Players:GetPlayers()) do
	recibir(jugador)
end

game:BindToClose(function()
	local limite = os.clock() + 24
	for _, ficha in pairs(sesiones) do
		task.spawn(cerrar, ficha, limite)
	end
	while next(sesiones) and os.clock() < limite do
		task.wait()
	end
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{80BC5045-9448-4389-B064-123BEA916CE3}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Progreso</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">16d01229428087e30b10072b000005ca</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXVersionMolinoModuleScriptProgresoDatos">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local ProgresoDatos = {}

ProgresoDatos.PrecioMejoraPedernal = 60

ProgresoDatos.Claves = table.freeze({
	"Cometa",
	"Vendaval",
	"Refugio",
	"Cornisa",
	"Pedernal",
	"Rebote",
	"TesoroRevelado",
	"MiradorGeoda",
	"SelloGeoda",
	"MolinoVista",
	"Lucero",
	"MejoraPedernal",
	"EncargoPedernal",
})

local premios = {
	Cometa = { 40, 20 },
	Pedernal = { 50, 30 },
	Lucero = { 70, 50 },
	Vendaval = { 20, 10 },
	Rebote = { 30, 15 },
}

local XP_NIVEL_DOS = 100

local function gananciasDeExpedicion(datos)
	local experiencia, monedas = 0, 0
	for nombre, premio in pairs(premios) do
		if datos[nombre] then
			experiencia += premio[1]
			monedas += premio[2]
		end
	end
	return experiencia, monedas
end

function ProgresoDatos.Normalizar(datos)
	local limpio = {}
	for _, nombre in ipairs(ProgresoDatos.Claves) do
		limpio[nombre] = type(datos) == "table" and datos[nombre] == true
	end

	-- Una recompensa del final de la ruta también prueba sus pasos previos.
	limpio.Vendaval = limpio.Vendaval or limpio.Cornisa
	limpio.Rebote = limpio.Rebote or limpio.SelloGeoda
	limpio.Pedernal = limpio.Pedernal or limpio.Rebote or limpio.TesoroRevelado
		or limpio.MiradorGeoda or limpio.Lucero
	limpio.Cometa = limpio.Cometa or limpio.Vendaval or limpio.Refugio or limpio.Lucero
	limpio.TesoroRevelado = limpio.Pedernal
	limpio.MolinoVista = limpio.MolinoVista or limpio.Lucero
	-- El encargo prueba la compra, pero su propio premio no puede financiarla.
	if limpio.MejoraPedernal or limpio.EncargoPedernal then
		local experiencia, monedas = gananciasDeExpedicion(limpio)
		limpio.MejoraPedernal = limpio.Pedernal and experiencia >= XP_NIVEL_DOS
			and monedas >= ProgresoDatos.PrecioMejoraPedernal
		limpio.EncargoPedernal = limpio.EncargoPedernal and limpio.MejoraPedernal
	end
	return limpio
end

function ProgresoDatos.Calcular(datos)
	local limpio = ProgresoDatos.Normalizar(datos)
	local experiencia, monedas = gananciasDeExpedicion(limpio)
	if limpio.EncargoPedernal then
		experiencia += 40
		monedas += 25
	end
	if limpio.MejoraPedernal then
		monedas -= ProgresoDatos.PrecioMejoraPedernal
	end

	-- El nivel 2 requiere 100 XP totales. Cada tramo siguiente cuesta 20 XP más.
	local nivel, xpNivel, xpMeta = 1, experiencia, XP_NIVEL_DOS
	while xpNivel >= xpMeta do
		xpNivel -= xpMeta
		nivel += 1
		xpMeta += 20
	end
	return {
		Nivel = nivel,
		Experiencia = experiencia,
		Monedas = monedas,
		XpNivel = xpNivel,
		XpMeta = xpMeta,
	}
end

function ProgresoDatos.PuedeComprarPedernal(datos)
	local limpio = ProgresoDatos.Normalizar(datos)
	if limpio.MejoraPedernal then
		return false, "YaComprada"
	end
	if not limpio.Pedernal then
		return false, "FaltaPedernal"
	end
	local estado = ProgresoDatos.Calcular(limpio)
	if estado.Nivel < 2 then
		return false, "FaltaNivel"
	end
	if estado.Monedas < ProgresoDatos.PrecioMejoraPedernal then
		return false, "MonedasInsuficientes"
	end
	return true, "Comprada"
end

function ProgresoDatos.RecargaEscudo(datos)
	return if type(datos) == "table" and datos.MejoraPedernal == true then 2.65 else 3.95
end

function ProgresoDatos.Fusionar(anterior, ganado)
	if anterior ~= nil and type(anterior) ~= "table" then
		return nil
	end

	local conservado = if anterior then table.clone(anterior) else {}
	for _, nombre in ipairs(ProgresoDatos.Claves) do
		conservado[nombre] = conservado[nombre] == true or (type(ganado) == "table" and ganado[nombre] == true)
	end
	for nombre, obtenido in pairs(ProgresoDatos.Normalizar(conservado)) do
		conservado[nombre] = obtenido
	end
	local version = conservado.Version
	conservado.Version = if type(version) == "number" and version >= 2 then version else 2
	return conservado
end

function ProgresoDatos.Escribir(almacen, clave, ganado)
	local ok, resultado = pcall(function()
		return almacen:UpdateAsync(clave, function(anterior, informacionClave)
			local cambiado = ProgresoDatos.Fusionar(anterior, ganado)
			if cambiado and informacionClave then
				return cambiado, informacionClave:GetUserIds(), informacionClave:GetMetadata()
			end
			return cambiado
		end)
	end)
	if ok and type(resultado) == "table" then
		return resultado
	end
	return nil, if ok then "El perfil antiguo tiene un formato desconocido." else resultado
end

function ProgresoDatos.Memoria()
	local perfiles = {}
	local memoria = {}

	function memoria:GetAsync(clave)
		local perfil = perfiles[clave]
		return if perfil then table.clone(perfil) else nil
	end

	function memoria:UpdateAsync(clave, actualizar)
		local cambiado = actualizar(self:GetAsync(clave))
		if cambiado then
			perfiles[clave] = table.clone(cambiado)
		end
		return cambiado
	end

	return memoria
end

return ProgresoDatos
]]></ProtectedString>
				<string name="ScriptGuid">{AAC9E727-BAC5-4F66-BC26-0272D3989CFC}</string>
