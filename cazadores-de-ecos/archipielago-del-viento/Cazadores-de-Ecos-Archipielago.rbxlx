local function ocupado()
	return jugador:GetAttribute("MolinoPresentando") or jugador:GetAttribute("GeodaPresentando")
		or jugador:GetAttribute("FaroPresentando")
end

local function dispositivo()
	local entrada = UserInputService:GetLastInputType()
	local preferida = UserInputService.PreferredInput
	local mando = entrada.Name:match("^Gamepad") ~= nil or preferida == Enum.PreferredInput.Gamepad
	local tactil = not mando and (entrada == Enum.UserInputType.Touch or preferida == Enum.PreferredInput.Touch)
	return mando, tactil
end

local function cercaDelFarero()
	local personaje = jugador.Character
	local raiz = personaje and personaje:FindFirstChild("HumanoidRootPart")
	local refugio = isla:FindFirstChild("RefugioDelViento")
	local punto = refugio and refugio:FindFirstChild("PuntoFarero")
	local prompt = punto and punto:FindFirstChildOfClass("ProximityPrompt")
	return raiz ~= nil and punto ~= nil
		and (raiz.Position - punto.Position).Magnitude <= (if prompt then prompt.MaxActivationDistance + 0.5 else 10)
end

local function modeloDeEco(nombre)
	if nombre == "Nimbo" then
		local modelos = ReplicatedStorage:FindFirstChild("EcosDelFaro")
		return modelos and modelos:FindFirstChild(if jugador:GetAttribute("NimboAurora") then "NimboAurora" else "Nimbo")
	end
	if nombre == "Cometa" then
		local nido = isla:FindFirstChild("Nido")
		return nido and nido:FindFirstChild(nombre)
	elseif nombre == "Pedernal" then
		local geoda = workspace:FindFirstChild("CuevaDeLaGeoda")
		return ReplicatedStorage:FindFirstChild("PedernalCompanero") or (geoda and geoda:FindFirstChild(nombre))
	end
	local molino = isla:FindFirstChild("MolinoDelViento")
	return molino and molino:FindFirstChild(nombre)
end

local function mostrarModelo(modelo, retrato, direccion, altura)
	if retrato.CurrentCamera then
		return
	end
	if not (modelo and modelo:IsA("Model")) then
		return
	end
	local copia = modelo:Clone()
	if not copia then
		return
	end
	for _, pieza in ipairs(copia:GetDescendants()) do
		if pieza:IsA("LuaSourceContainer") then
			pieza:Destroy()
		elseif pieza:IsA("BasePart") then
			pieza.Anchored = true
			pieza.LocalTransparencyModifier = 0
			if pieza.Transparency == 1 and pieza.Size.Magnitude > 0.55 then
				pieza.Transparency = 0
			end
		end
	end
	local mundo = crear("WorldModel", retrato, {})
	copia.Parent = mundo
	copia:PivotTo(CFrame.new())
	local marcoEco, escala = copia:GetBoundingBox()
	local distancia = math.max(escala.X, escala.Y, escala.Z, 1) * 1.9
	local mira = marcoEco.Position + Vector3.new(0, altura or 0, 0)
	local camara = crear("Camera", retrato, { FieldOfView = 35,
		CFrame = CFrame.lookAt(mira + direccion * distancia, mira) })
	retrato.CurrentCamera = camara
end

local function dibujarColeccion()
	local cantidad = 0
	for i, eco in ipairs(datosEcos) do
		local ficha = fichas[i]
		local descubierto = jugador:GetAttribute(eco.nombre) == true
		if descubierto then
			cantidad += 1
			local modelo = modeloDeEco(eco.nombre)
			if modelo and ficha.retrato:GetAttribute("Modelo") ~= modelo.Name then
				if ficha.retrato.CurrentCamera then ficha.retrato.CurrentCamera:Destroy() end
				local mundo = ficha.retrato:FindFirstChildOfClass("WorldModel")
				if mundo then mundo:Destroy() end
				ficha.retrato:SetAttribute("Modelo", modelo.Name)
			end
			mostrarModelo(modelo, ficha.retrato, Vector3.new(-0.57, 0.28, -0.79))
		end
		ficha.retrato.Visible = descubierto and ficha.retrato.CurrentCamera ~= nil
		ficha.pendiente.Text = if descubierto then eco.nombre else "Por descubrir"
		ficha.pendiente.Visible = not ficha.retrato.Visible
		ficha.nombre.Text = if descubierto then eco.nombre else "Eco desconocido"
		ficha.habilidad.Text = if descubierto then eco.habilidad else "Explora este lugar para encontrarlo."
		local mutado = eco.mutacion and jugador:GetAttribute(eco.mutacion)
		local evolucion = {}
		if descubierto and mutado then
			table.insert(evolucion, (eco.variante or eco.mutacion) .. " · " .. eco.beneficio)
		end
		if descubierto and eco.nombre == "Pedernal" and jugador:GetAttribute("MejoraPedernal") then
			table.insert(evolucion, "Mejora · Escudo rápido")
		elseif descubierto and eco.nombre == "Cometa" then
			table.insert(evolucion, if jugador:GetAttribute("PlaneadorEquipado") == "Avanzado"
				then "Equipo · Planeador avanzado" else "Equipo · Planeador básico")
		end
		ficha.mutacion.Text = table.concat(evolucion, "\n")
	end
	fichaLente.Visible = jugador:GetAttribute("LenteGeoda") == true
	return cantidad
end

local function dibujarPlaneadores()
	local tengoBasico = jugador:GetAttribute("Cometa") == true
	local tengoAvanzado = jugador:GetAttribute("PlaneadorAvanzado") == true
	for orden, ficha in ipairs(fichasPlaneadores) do
		local avanzado = orden == 2
		ficha.tarjeta.Visible = not avanzado or tengoAvanzado
		if not ficha.tarjeta.Visible then
			continue
		end
		if not ficha.retrato.CurrentCamera then
			local rig = Planeadores.crear(avanzado)
			Planeadores.colocar(rig, Vector3.zero, -Vector3.zAxis, 1, 0)
			local mundo = crear("WorldModel", ficha.retrato, {})
			rig.modelo.Parent = mundo
			rig.modelo.PrimaryPart = rig.cuerpo.PrimaryPart
			local centro, medida = rig.modelo:GetBoundingBox()
			local foco = centro.Position + Vector3.yAxis * 0.35
			local camara = crear("Camera", ficha.retrato, { FieldOfView = 38 })
			local function encuadrar()
				local tam = ficha.retrato.AbsoluteSize
				local aspecto = math.max(0.5, tam.X / math.max(1, tam.Y))
				local distancia = math.max(medida.X / aspecto, medida.Z) * 1.55 + 0.6
				camara.CFrame = CFrame.lookAt(foco + Vector3.new(0, 0.93, -0.37).Unit * distancia, foco)
			end
			encuadrar()
			ficha.retrato:GetPropertyChangedSignal("AbsoluteSize"):Connect(encuadrar)
			ficha.retrato.CurrentCamera = camara
		end
		local obtenido = if avanzado then tengoAvanzado else tengoBasico
		local equipado = obtenido and ficha.id == (jugador:GetAttribute("PlaneadorEquipado") or "Basico")
		ficha.elegir.Visible = obtenido and not equipado
		ficha.elegir.Active = ficha.elegir.Visible and jugador:GetAttribute("ProgresoListo") == true and not solicitud
		ficha.elegir.Selectable = ficha.elegir.Visible
		ficha.elegir.AutoButtonColor = ficha.elegir.Active
		ficha.elegir.Text = if solicitud == ficha.accion then "Equipando…" else "Equipar"
		ficha.estado.Visible = not ficha.elegir.Visible
		if GuiService.SelectedObject == ficha.elegir and not ficha.elegir.Visible then
			GuiService.SelectedObject = verPlaneadores
		end
		ficha.estado.Text = if equipado then "Equipado" elseif obtenido then "Obtenido" else "Por conseguir"
		ficha.detalle.Text = if avanzado
			then ("Un %d %% más rápido que el básico. Hasta 3,05 s de planeo."):format(ventajaVelocidad)
			else (if obtenido then "Hasta 2,45 s de planeo." else "Rescata a Cometa para desbloquearlo.")
	end
end

local function dibujarProgreso()
	local listo = jugador:GetAttribute("ProgresoListo") == true
	local nivelActual = jugador:GetAttribute("Nivel") or 1
	local xpActual = jugador:GetAttribute("XpNivel") or 0
	local meta = math.max(1, jugador:GetAttribute("XpMeta") or 100)
	local monedas = jugador:GetAttribute("Monedas") or 0
	local mando, tactil = dispositivo()
	nivel.Text = if listo then tostring(nivelActual) else "…"
	saldo.Text = if listo then tostring(monedas) else "…"
	xp.Text = if listo then ("%d / %d XP"):format(xpActual, meta) else ""
	progresoXP.Size = UDim2.fromScale(if listo then math.clamp(xpActual / meta, 0, 1) else 0, 1)
	etiquetaEcos.Text = if mando then "Bolsa ↑" elseif tactil then "Inventario" else "Bolsa [I]"
	etiquetaEcos.Active = mando or tactil
	etiquetaEcos.Selectable = mando
	etiquetaEcos.AutoButtonColor = mando or tactil
end

local function dibujarDialogo()
	local tema = pantalla == "SenalFaro"
	temaFaro.Visible = not tema
	temaMejoras.Visible = not tema
	seguirSenal.Visible = tema and jugador:GetAttribute("Lucero") == true and jugador:GetAttribute("LenteGeoda") == true
	volverDeSenal.Visible = tema
	local puedoEnviar = dialogoAutorizado and enAlcance and jugador:GetAttribute("ProgresoListo")
		and jugador:GetAttribute("Lucero") and jugador:GetAttribute("LenteGeoda") and (jugador:GetAttribute("Nivel") or 1) >= NIVEL_MINIMO
		and not solicitud
	seguirSenal.Active = puedoEnviar == true
	seguirSenal.Selectable = seguirSenal.Active
	seguirSenal.AutoButtonColor = seguirSenal.Active
	seguirSenal.BackgroundColor3 = if seguirSenal.Active then ORO else PANEL
	seguirSenal.TextColor3 = if seguirSenal.Active then NOCHE else SUAVE
	seguirSenal.Text = if solicitud == "PrepararFaro" then "Preparando la salida…" else "Seguir la señal"
	local _, destino = RutaIslas.destino(jugador)
	fraseFarero.Text = respuestaFarero or destino[3]
	temaFaro.Text = if jugador:GetAttribute("LenteGeoda") and jugador:GetAttribute("Lucero") then "Seguir la señal del faro" else "¿Adónde voy ahora?"
end

local function dibujarTienda()
	local listo = jugador:GetAttribute("ProgresoListo") == true
	local escudoEquipado = jugador:GetAttribute("MejoraPedernal") == true
	local planeadorComprado = jugador:GetAttribute("PlaneadorAvanzado") == true
	local planeadorEquipado = planeadorComprado and jugador:GetAttribute("PlaneadorEquipado") == "Avanzado"
	local nivelActual = jugador:GetAttribute("Nivel") or 1
	local monedas = jugador:GetAttribute("Monedas") or 0
	subtitulo.Text = if listo then ("Tu bolsa · %d monedas"):format(monedas) else "Consultando tu progreso…"
	subtitulo.TextColor3 = ORO
	palabrasFarero.Text = respuestaFarero or (if escudoEquipado and planeadorEquipado
		then "Ya equipé a Pedernal con Escudo rápido y a Cometa con el planeador avanzado."
		elseif escudoEquipado then "Pedernal ya tiene Escudo rápido. Si quieres probarlo, acércate al relevo de los faroles."
		elseif planeadorEquipado then "Ya te entregué el planeador avanzado. Salta y activa el planeo para desplegarlo."
		elseif planeadorComprado then "Tu planeador avanzado está listo. Puedes equiparlo aquí o en tu inventario."
		else "Puedo ajustar el escudo de Pedernal o preparar un planeador más ágil para tus viajes.")
	for _, mejora in ipairs(mejoras) do
		local comprada = jugador:GetAttribute(mejora.atributo) == true
		local equipada = comprada and (mejora.compra ~= "ComprarPlaneador" or planeadorEquipado)
		local causa
		if not listo then
			causa = "ProgresoNoListo"
		elseif not jugador:GetAttribute(mejora.eco) then
			causa = if mejora.eco == "Pedernal" then "FaltaPedernal" else "FaltaCometa"
		elseif mejora.eco == "Pedernal" and nivelActual < NIVEL_MINIMO then
			causa = "FaltaNivel"
		elseif not comprada and monedas < mejora.precio then
			causa = "MonedasInsuficientes"
		elseif not dialogoAutorizado or not enAlcance then
			causa = "Lejos"
		end
		local disponible = not equipada and not causa and not solicitud
		local comprar = mejora.boton
		comprar.Active = disponible
		comprar.Selectable = disponible or solicitud == mejora.compra or (comprada and solicitud == "EquiparAvanzado" and mejora.eco == "Cometa")
		if GuiService.SelectedObject == comprar and not comprar.Selectable then
			GuiService.SelectedObject = volverDeTienda
		end
		comprar.AutoButtonColor = disponible
		comprar.BackgroundColor3 = if disponible then mejora.color else PANEL
		comprar.TextColor3 = if disponible then NOCHE else SUAVE
		comprar.Text = if equipada then "Equipado"
			elseif comprada then (if solicitud == "EquiparAvanzado" then "Equipando…" else "Equipar")
			elseif solicitud == mejora.compra then "Comprando…"
			else ("Comprar · %d monedas"):format(mejora.precio)
		mejora.estado.Text = if equipada and mejora.eco == "Pedernal" and not jugador:GetAttribute("EncargoPedernal")
			then "Prueba el escudo en el relevo de los faroles."
			elseif equipada then "Ya forma parte de tu equipo."
			elseif comprada then "Ya es tuyo. Puedes cambiarlo cuando quieras."
			elseif causa == "MonedasInsuficientes" then ("Te faltan %d monedas."):format(mejora.precio - monedas)
			elseif causa then mensajes[causa]
			else ("Te quedarán %d monedas. Compra permanente."):format(monedas - mejora.precio)
	end
end

local function actualizarPanel()
	local coleccion = pantalla == "Inventario"
	local intercambio = pantalla == "Mejoras"
	local conversacion = not coleccion and not intercambio
	panel.Visible = not conversacion
	panel.BackgroundColor3 = if intercambio then TINTA else NOCHE
	dialogo.Visible = conversacion
	fondo.BackgroundTransparency = if conversacion then 0.90 else 0.29
	inventario.Visible = coleccion and not viendoPlaneadores
	equipo.Visible = coleccion and viendoPlaneadores
	verEcos.Visible = coleccion
	verPlaneadores.Visible = coleccion
	verEcos.BackgroundColor3 = if viendoPlaneadores then TARJETA else TURQUESA
	verPlaneadores.BackgroundColor3 = if viendoPlaneadores then TURQUESA else TARJETA
	verEcos.TextColor3 = if viendoPlaneadores then PERLA else NOCHE
	verPlaneadores.TextColor3 = if viendoPlaneadores then NOCHE else PERLA
	tienda.Visible = intercambio
	volverDeTienda.Visible = intercambio
	palabrasFarero.Visible = intercambio
	titulo.Text = if coleccion then "Inventario" else "Taller del Farero"
	titulo.Font = if intercambio then Enum.Font.Bodoni else Enum.Font.GothamBold
	titulo.Size = UDim2.new(1, if intercambio then -169 else -82, 0, 32)
	if coleccion then
		subtitulo.TextColor3 = SUAVE
		if viendoPlaneadores then
			dibujarPlaneadores()
			subtitulo.Text = respuestaFarero or (if not jugador:GetAttribute("ProgresoListo") then "Cargando el equipo…"
				elseif jugador:GetAttribute("PlaneadorEquipado") == "Avanzado" then "Equipado · Planeador avanzado"
				elseif jugador:GetAttribute("Cometa") then "Equipado · Planeador básico"
				else "Rescata a Cometa para equipar tu primer planeador.")
		else
			local descubiertos = dibujarColeccion()
			subtitulo.Text = if jugador:GetAttribute("ProgresoListo")
				then ("%d de %d Ecos descubiertos"):format(descubiertos, #datosEcos) else "Cargando la colección…"
		end
	elseif intercambio then
		dibujarTienda()
	else
		subtitulo.Text = if pantalla == "SenalFaro" then "Las Ruinas del Faro" else ""
		dibujarDialogo()
	end
	dibujarProgreso()
end

local function enfocarAlFarero()
	if avisoHabilitado == nil then
		avisoHabilitado = avisoFarero.Enabled
		avisoFarero.Enabled = false
		local seguidores = isla:FindFirstChild("CompanerosCometa")
		local propio = seguidores and seguidores:FindFirstChild(tostring(jugador.UserId))
		local ocultar = if propio then {propio} else {isla.Nido.Cometa}
		if jugador.Character and not GuiService.ReducedMotionEnabled then
			table.insert(ocultar, jugador.Character)
		end
		for _, modelo in ocultar do
			for _, pieza in modelo:GetDescendants() do
				if pieza:IsA("BasePart") then
					partesOcultas[pieza] = pieza.LocalTransparencyModifier
					pieza.LocalTransparencyModifier = 1
				end
			end
		end
	end
	jugador:SetAttribute("FareroConversando", true)
	local camara = workspace.CurrentCamera
	if camara and not tomaFarero and camara.CameraType == Enum.CameraType.Custom and not GuiService.ReducedMotionEnabled then
		local cabeza = rostroFarero.Position
		local raiz = jugador.Character and jugador.Character:FindFirstChild("HumanoidRootPart")
		local lado = if raiz and raiz.Position.X > cabeza.X then -1 else 1
		local mira = cabeza - Vector3.yAxis * 0.85
		tomaFarero = { camara = camara, marco = camara.CFrame, foco = camara.Focus, fov = camara.FieldOfView }
		local plano = CFrame.lookAt(cabeza + Vector3.new(lado * 2.1, 0.55, 6.6), mira)
		camara.CameraType = Enum.CameraType.Scriptable
		RunService:BindToRenderStep(CAMARA_FARERO, Enum.RenderPriority.Camera.Value + 1, function()
			camara.CFrame = plano
			camara.Focus = CFrame.new(mira)
			camara.FieldOfView = 57
		end)
	end
end

local function recuperarVista()
	if avisoHabilitado ~= nil then
		avisoFarero.Enabled = avisoHabilitado
		avisoHabilitado = nil
		for pieza, opacidad in pairs(partesOcultas) do
			if pieza.Parent then
				pieza.LocalTransparencyModifier = opacidad
			end
		end
		table.clear(partesOcultas)
		jugador:SetAttribute("FareroConversando", false)
	end
	if tomaFarero then
		RunService:UnbindFromRenderStep(CAMARA_FARERO)
		local camara = tomaFarero.camara
		if camara == workspace.CurrentCamera and camara.CameraType == Enum.CameraType.Scriptable then
			camara.CFrame = tomaFarero.marco
			camara.Focus = tomaFarero.foco
			camara.FieldOfView = tomaFarero.fov
			camara.CameraType = Enum.CameraType.Custom
		end
		tomaFarero = nil
	end
end

local function abrir(destino, conFarero)
	if ocupado() then
		return
	end
	if not menu.Visible then
		seleccionAnterior = GuiService.SelectedObject
	end
	if conFarero then
		dialogoAutorizado = true
	end
	if destino == "Inventario" then
		dialogoAutorizado = false
		recuperarVista()
	end
	respuestaFarero = nil
	enAlcance = cercaDelFarero()
	pantalla = destino
	menu.Visible = true
	progreso.Visible = false
	aviso.Visible = false
	if conFarero then
		enfocarAlFarero()
	end
	actualizarPanel()
	local mando = dispositivo()
	if mando then
		GuiService.SelectedObject = if destino == "Dialogo" then temaFaro
			elseif destino == "Mejoras" then volverDeTienda
			elseif destino == "SenalFaro" and seguirSenal.Active then seguirSenal
			elseif destino == "SenalFaro" then volverDeSenal elseif viendoPlaneadores then verPlaneadores else verEcos
	end
end

local function cerrarPanel()
	if not menu.Visible then
		return
	end
	menu.Visible = false

	recuperarVista()
	dialogoAutorizado = false
	local seleccionado = GuiService.SelectedObject
	if not seleccionado or seleccionado:IsDescendantOf(panel) or seleccionado:IsDescendantOf(dialogo) then
		GuiService.SelectedObject = if seleccionAnterior and seleccionAnterior.Parent then seleccionAnterior else nil
	end
	seleccionAnterior = nil
end

local function alternar()
	if menu.Visible and pantalla == "Inventario" then
		cerrarPanel()
	else
		abrir("Inventario")
	end
end

local function adaptar()
	local ancho = menu.AbsoluteSize.X
	local mayor = ancho >= 680
	progreso.Position = UDim2.new(1, -13, 0, if mayor then 9 else 126)
	aviso.Position = UDim2.new(1, -13, 0, if mayor then 98 else 215)
	local disponible = inventario.AbsoluteSize.X - 11
	local columnas = if disponible >= 590 then 3 elseif disponible >= 400 then 2 else 1
	grid.FillDirectionMaxCells = columnas
	grid.CellSize = UDim2.fromOffset(math.max(0, math.floor((disponible - (columnas - 1) * 12) / columnas)), 262)
	local anchoEquipo = equipo.AbsoluteSize.X - 11
	local columnasEquipo = if anchoEquipo >= 430 then 2 else 1
	gridEquipo.FillDirectionMaxCells = columnasEquipo
	gridEquipo.CellSize = UDim2.fromOffset(math.max(0, math.floor((anchoEquipo - (columnasEquipo - 1) * 12) / columnasEquipo)), 250)
	local anchoTienda = tienda.AbsoluteSize.X - 11
	local ladoALado = anchoTienda >= 575
	contenido.Size = UDim2.new(1, -11, 0, if ladoALado then 216 else 443)
	for i, mejora in ipairs(mejoras) do
		mejora.tarjeta.Position = if ladoALado then UDim2.new((i - 1) * 0.5, (i - 1) * 6, 0, 0)
			else UDim2.fromOffset(0, (i - 1) * 225)
		mejora.tarjeta.Size = if ladoALado then UDim2.new(0.5, -6, 0, 213) else UDim2.new(1, 0, 0, 213)
	end
	local estrecho = ancho < 445
	palabrasFarero.TextSize = if estrecho then 13 else 14
	palabrasFarero.Size = UDim2.new(1, -34, 0, if estrecho then 72 else 52)
	tienda.Position = UDim2.fromOffset(13, if estrecho then 149 else 129)
	tienda.Size = UDim2.new(1, -26, 1, if estrecho then -161 else -141)
	local apilado = ancho < 550
	local alto = if apilado then 216 else 152
	dialogo.Size = UDim2.new(1, -24, 0, alto)
	fraseFarero.Size = if apilado then UDim2.new(1, -32, 0, 71) else UDim2.new(0.54, -29, 1, -64)
	fraseFarero.TextSize = if apilado then 14 else 16
	local respuestas = temaMejoras.Parent
	respuestas.Position = if apilado then UDim2.new(0, 15, 1, -98) else UDim2.new(0.54, 0, 0, 52)
	respuestas.Size = if apilado then UDim2.new(1, -30, 0, 88) else UDim2.new(0.46, -15, 1, -64)
end

local function usarEscudo()
	if ocupado() or menu.Visible or not jugador:GetAttribute("EnEncargoPedernal") then
		return false
	end
	local tiempo = workspace:GetServerTimeNow()
	if tiempo >= (jugador:GetAttribute("EscudoRefugioListoEn") or 0) and os.clock() >= proximoEscudo then
		proximoEscudo = os.clock() + 0.2
		remoto:FireServer("Escudo")
	end
	return true
end

require(ReplicatedStorage:WaitForChild("ControlesCombate")).escudoBreve(function()
	return jugador:GetAttribute("EnEncargoPedernal") == true and not menu.Visible and not ocupado()
end, usarEscudo)

local function pedir(accion)
	if solicitud then
		return
	end
	solicitud = accion
	numeroSolicitud += 1
	hastaSolicitud = os.clock() + 4
	respuestaFarero = nil
	actualizarPanel()
	remoto:FireServer(accion, numeroSolicitud)
end

etiquetaEcos.Activated:Connect(function()
	local mando, tactil = dispositivo()
	if mando or tactil then
		alternar()
	end
end)
fondo.Activated:Connect(cerrarPanel)
cerrar.Activated:Connect(cerrarPanel)
despedir.Activated:Connect(cerrarPanel)
verEcos.Activated:Connect(function()
	viendoPlaneadores = false
	actualizarPanel()
end)
verPlaneadores.Activated:Connect(function()
	viendoPlaneadores = true
	actualizarPanel()
end)
temaFaro.Activated:Connect(function() abrir("SenalFaro") end)
temaMejoras.Activated:Connect(function() abrir("Mejoras") end)
volverDeSenal.Activated:Connect(function() abrir("Dialogo") end)
volverDeTienda.Activated:Connect(function() abrir("Dialogo") end)
seguirSenal.Activated:Connect(function()
	if seguirSenal.Active then
		pedir("PrepararFaro")
	end
end)
escudo.Activated:Connect(usarEscudo)
for _, ficha in ipairs(fichasPlaneadores) do
	ficha.elegir.Activated:Connect(function()
		if ficha.elegir.Active then
			pedir(ficha.accion)
		end
	end)
end
for _, mejora in ipairs(mejoras) do
	mejora.boton.Activated:Connect(function()
		if mejora.boton.Active then
			if mejora.compra == "ComprarPlaneador" and jugador:GetAttribute("PlaneadorAvanzado") then
				pedir("EquiparAvanzado")
			else
				pedir(mejora.compra)
			end
		end
	end)
end

ContextActionService:BindActionAtPriority("AbrirInventarioEcos", function(_, estado, entrada)
	if ocupado() or UserInputService:GetFocusedTextBox()
		or (entrada.KeyCode == Enum.KeyCode.DPadUp and menu.Visible) then
		return Enum.ContextActionResult.Pass
	end
	if estado == Enum.UserInputState.Begin then
		alternar()
	end
	return Enum.ContextActionResult.Sink
end, false, ALTA, Enum.KeyCode.I, Enum.KeyCode.DPadUp)

ContextActionService:BindActionAtPriority("CerrarInventarioEcos", function(_, estado)
	if not menu.Visible then
		return Enum.ContextActionResult.Pass
	end
	if estado == Enum.UserInputState.Begin then
		cerrarPanel()
	end
	return Enum.ContextActionResult.Sink
end, false, ALTA, Enum.KeyCode.Backspace, Enum.KeyCode.ButtonB)

ContextActionService:BindActionAtPriority("EscudoDelRefugio", function(_, estado)
	if estado == Enum.UserInputState.Begin and usarEscudo() then
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end, false, ALTA, Enum.KeyCode.ButtonR1)

ContextActionService:BindActionAtPriority("InteraccionesInventarioEcos", function()
	return if menu.Visible then Enum.ContextActionResult.Sink else Enum.ContextActionResult.Pass
end, false, ALTA, Enum.KeyCode.E, Enum.KeyCode.Q, Enum.KeyCode.C, Enum.KeyCode.F,
	Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonY, Enum.KeyCode.ButtonR1)

local function guardarToast(tituloAviso, detalleAviso)
	toastPendiente = { tituloAviso, detalleAviso }
end

remoto.OnClientEvent:Connect(function(evento, ok, codigo, accion, numero)
	if numero and numero ~= numeroSolicitud then
		return
	end
	if evento == "AbrirTienda" then
		abrir("Dialogo", true)
	elseif evento == "ResultadoCompra" or evento == "ResultadoPlaneador" then
		local planeador = evento == "ResultadoPlaneador"
		local esperada = if planeador then "ComprarPlaneador" else "ComprarPedernal"
		if solicitud == esperada then
			solicitud, hastaSolicitud = nil, 0
		end
		local respuesta
		if ok then
			respuesta = if planeador
				then "Ya es tuyo. Pulsa Equipar cuando quieras probar el planeador avanzado."
				else "¡Listo! El escudo de Pedernal se recupera más rápido. Ahora ve al relevo y enciende los dos faroles."
		elseif codigo == "YaComprada" then
			respuesta = if planeador then "Ya tienes ese planeador. Puedes elegirlo en tu inventario."
				else "Pedernal ya tiene equipado Escudo rápido. Pruébalo en el relevo de los faroles."
		else
			respuesta = mensajes[codigo] or "No pude registrar la compra. Inténtalo otra vez."
		end
		if menu.Visible and pantalla == "Mejoras" then
			respuestaFarero = respuesta
			actualizarPanel()
		end
	elseif evento == "ResultadoEquipo" then
		if solicitud == accion then
			solicitud, hastaSolicitud = nil, 0
		end
		if menu.Visible and (pantalla == "Inventario" or pantalla == "Mejoras") then
			if ok then
				respuestaFarero = if pantalla == "Mejoras" then "Ya está equipado. Lo desplegarás en tu próximo vuelo." else nil
			else
				respuestaFarero = mensajes[codigo] or "No pude cambiar el planeador. Inténtalo de nuevo."
			end
			actualizarPanel()
		end
	elseif evento == "SalidaAlFaro" then
		if solicitud == "PrepararFaro" then
			solicitud, hastaSolicitud = nil, 0
		end
		if ok then
			if pantalla ~= "Inventario" then
				cerrarPanel()
			end
		else
			respuestaFarero = mensajes[codigo] or "Todavía no puedo indicarte la salida."
			if menu.Visible and pantalla == "SenalFaro" then
				actualizarPanel()
			end
		end
	elseif evento == "EncargoCompleto" then
		premioEncargo = true
		mostrarPremioEn = os.clock() + 0.45
	end
end)

local function leerPremio()
	local exp = jugador:GetAttribute("Experiencia") or 0
	local dinero = jugador:GetAttribute("Monedas") or 0
	if jugador:GetAttribute("ProgresoListo") then
		local diferenciaXP = math.max(0, exp - xpPrevio)
		local diferenciaMonedas = math.max(0, dinero - saldoPrevio)
		sumarXP += diferenciaXP
		sumarMonedas += diferenciaMonedas
		if diferenciaXP > 0 or diferenciaMonedas > 0 then
			mostrarPremioEn = os.clock() + 0.45
		end
	end
	xpPrevio, saldoPrevio = exp, dinero
end

local function actualizarEncargo(ahora)
	local mando, tactil = dispositivo()
	local accion = if tactil then "Toca Escudo" elseif mando then "Pulsa R1" else "Clic derecho breve"
	local estado = jugador:GetAttribute("EstadoEncargo")
	local restante = math.max(0, (jugador:GetAttribute("EncargoHasta") or 0) - ahora)
	local escudado = math.max(0, (jugador:GetAttribute("EscudoRefugioHasta") or 0) - ahora)
	local recarga = math.max(0, (jugador:GetAttribute("EscudoRefugioListoEn") or 0) - ahora)
	if estado == "Segundo" then
		encargoTitulo.Text = ("Segundo faro · %.0f s"):format(math.ceil(restante))
		encargoPista.Text = if recarga > 0 then ("Corre al segundo faro. Escudo listo en %.1f s."):format(recarga)
			else accion .. " junto al segundo faro."
	elseif estado == "Meta" or estado == "Final" then
		encargoTitulo.Text = "Faros protegidos"
		encargoPista.Text = "Interactúa con la baliza para completar el encargo."
	elseif estado == "Reintentar" then
		encargoTitulo.Text = "La primera llama sigue encendida"
		encargoPista.Text = "Recupera la chispa en el segundo farol. " .. accion .. " junto a su llama."
	else
		encargoTitulo.Text = "Primer faro"
		encargoPista.Text = "Farero: «Mira cómo se inclina la llama». " .. accion .. " junto al primer farol."
	end
	if estado == "Segundo" then
		if not finAnterior or finAnterior ~= jugador:GetAttribute("EncargoHasta") then
			finAnterior = jugador:GetAttribute("EncargoHasta")
			tiempoTotal = math.max(1, restante)
		end
		tomaTiempo.Size = UDim2.fromScale(math.clamp(restante / tiempoTotal, 0, 1), 1)
	end
	tomaTiempo.Parent.Visible = estado == "Segundo"
	escudo.Visible = tactil and estado ~= "Meta" and estado ~= "Final"
	escudo.Active = recarga <= 0
	escudo.Text = if escudado > 0 then "Protegido" elseif recarga > 0 then ("Escudo · %.1f s"):format(recarga) else "Escudo"
	escudo.TextColor3 = if escudado > 0 then MENTA elseif recarga > 0 then SUAVE else HIELO
end

for _, nombre in ipairs({ "Experiencia", "Monedas" }) do
	jugador:GetAttributeChangedSignal(nombre):Connect(leerPremio)
end
jugador:GetAttributeChangedSignal("ProgresoListo"):Connect(function()
	xpPrevio = jugador:GetAttribute("Experiencia") or 0
	saldoPrevio = jugador:GetAttribute("Monedas") or 0
	nivelMostrado = jugador:GetAttribute("Nivel") or 1
end)

for _, nombre in ipairs({ "Nivel", "XpNivel", "XpMeta", "Monedas", "Cometa", "Vendaval", "Pedernal", "Rebote",
	"Lucero", "Prisma", "Nimbo", "NimboAurora", "LenteGeoda", "MejoraPedernal", "EncargoPedernal", "PlaneadorAvanzado",
	"PlaneadorEquipado", "ProgresoListo" }) do
	jugador:GetAttributeChangedSignal(nombre):Connect(function()
		if menu.Visible then
			actualizarPanel()
		else
			dibujarProgreso()
		end
	end)
end
menu:GetPropertyChangedSignal("AbsoluteSize"):Connect(adaptar)
inventario:GetPropertyChangedSignal("AbsoluteSize"):Connect(adaptar)
equipo:GetPropertyChangedSignal("AbsoluteSize"):Connect(adaptar)
tienda:GetPropertyChangedSignal("AbsoluteSize"):Connect(adaptar)
UserInputService.LastInputTypeChanged:Connect(dibujarProgreso)
UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(dibujarProgreso)
jugador.CharacterRemoving:Connect(cerrarPanel)
adaptar()
actualizarPanel()

local refresco = 0
RunService.Heartbeat:Connect(function(dt)
	refresco += dt
	if refresco < 0.09 then
		return
	end
	refresco = 0

	local ahora = os.clock()
	local presenta = ocupado()
	local enEncargo = jugador:GetAttribute("EnEncargoPedernal") == true
	local humanoide = jugador.Character and jugador.Character:FindFirstChildOfClass("Humanoid")
	local vivo = humanoide ~= nil and humanoide.Health > 0
	if presenta or not vivo then
		cerrarPanel()
	end
	progreso.Visible = not presenta and not menu.Visible and vivo
	encargo.Visible = enEncargo and not presenta and not menu.Visible and vivo
	if encargo.Visible then
		actualizarEncargo(workspace:GetServerTimeNow())
	else
		escudo.Visible = false
	end
	if solicitud and ahora >= hastaSolicitud then
		solicitud, hastaSolicitud = nil, 0
		if menu.Visible then
			actualizarPanel()
		end
	end
	if menu.Visible and pantalla ~= "Inventario" and dialogoAutorizado then
		local cerca = cercaDelFarero()
		if not cerca then
			cerrarPanel()
		elseif cerca ~= enAlcance then
			enAlcance = cerca
			actualizarPanel()
		end
	end
	if mostrarPremioEn and ahora >= mostrarPremioEn then
		local actual = jugador:GetAttribute("Nivel") or 1
		local premio = {}
		if sumarXP > 0 then
			table.insert(premio, ("+%d XP"):format(sumarXP))
		end
		if sumarMonedas > 0 then
			table.insert(premio, ("+%d monedas"):format(sumarMonedas))
		end
		local tituloPremio = if premioEncargo then "Encargo completado"
			elseif actual > nivelMostrado then ("¡Nivel %d!"):format(actual)
			else "Progreso de expedición"
		guardarToast(tituloPremio, if #premio > 0 then table.concat(premio, "  ·  ") else "Protegiste los dos faros.")
		premioEncargo = false
		nivelMostrado = actual
		mostrarPremioEn = nil
		sumarXP, sumarMonedas = 0, 0
	end
	if progreso.Visible and toastPendiente then
		avisoTitulo.Text = toastPendiente[1]
		avisoDetalle.Text = toastPendiente[2]
		toastHasta = ahora + 4.2
		toastPendiente = nil
	end
	aviso.Visible = progreso.Visible and ahora < toastHasta
end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{928B6101-5D9A-48F7-9B63-110B4358AA69}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Refugio</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16d01229428087e30b10072b000005c5</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBXVersionFaroLocalScriptFaro">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local jugador = Players.LocalPlayer
local faro = workspace:WaitForChild("IslaDelViento"):WaitForChild("RuinasDelFaro")
local accion = ReplicatedStorage:WaitForChild("AccionFaro")
local refugio = ReplicatedStorage:WaitForChild("AccionRefugio")
local noche = Color3.fromRGB(17, 28, 44)
local claro = Color3.fromRGB(248, 246, 236)
local suave = Color3.fromRGB(202, 219, 233)
local agua = Color3.fromRGB(141, 232, 218)

local function crear(clase, padre, props)
	local objeto = Instance.new(clase)
	for nombre, valor in pairs(props) do
		objeto[nombre] = valor
	end
	objeto.Parent = padre
	return objeto
end

local gui = crear("ScreenGui", jugador:WaitForChild("PlayerGui"), {
	Name = "RuinasDelFaroHUD", ResetOnSpawn = false, DisplayOrder = 11,
	ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, Enabled = false,
})
local tarjeta = crear("Frame", gui, {
	Name = "Objetivo", Size = UDim2.new(1, -30, 0, 77), Position = UDim2.fromOffset(14, 9),
	BackgroundColor3 = noche, BackgroundTransparency = 0.08, BorderSizePixel = 0,
})
crear("UISizeConstraint", tarjeta, { MaxSize = Vector2.new(326, 77) })
crear("UICorner", tarjeta, { CornerRadius = UDim.new(0, 11) })
crear("UIStroke", tarjeta, { Color = agua, Transparency = 0.63 })
local titulo = crear("TextLabel", tarjeta, {
	Name = "Titulo", Position = UDim2.fromOffset(12, 7), Size = UDim2.new(1, -24, 0, 23),
	BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextColor3 = agua, TextSize = 16,
	TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
})
local pista = crear("TextLabel", tarjeta, {
	Name = "Pista", Position = UDim2.fromOffset(12, 33), Size = UDim2.new(1, -24, 0, 38),
	BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextColor3 = suave, TextSize = 12,
	TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
})
local luz = crear("TextButton", gui, {
	Name = "Iluminar", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20),
	Size = UDim2.fromOffset(192, 47), BackgroundColor3 = noche, BorderSizePixel = 0, Visible = false,
	Text = "Iluminar", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = claro,
})
crear("UICorner", luz, { CornerRadius = UDim.new(0, 10) })
crear("UIStroke", luz, { Color = agua, Transparency = 0.42 })

local function raiz()
	local c = jugador.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return if h and h.Health > 0 then c:FindFirstChild("HumanoidRootPart") else nil
end

local function cercaDelRastro(root)
	return root and jugador:GetAttribute("EnFaro") and not faro:GetAttribute("RastroRevelado")
		and (root.Position - faro.Rastro.Position).Magnitude <= 13
end

local function pedirLuz()
	if not cercaDelRastro(raiz()) then
		return false
	end
	accion:FireServer("Lucero")
	return true
end

luz.Activated:Connect(pedirLuz)
ContextActionService:BindActionAtPriority("LuzDeLucero", function(_, estado)
	if estado == Enum.UserInputState.Begin and pedirLuz() then
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.C, Enum.KeyCode.ButtonR1)

local despegueHasta = 0
local reintento = false
accion.OnClientEvent:Connect(function(evento)
	if evento == "ReintentarLlegada" then
		reintento = true
		despegueHasta = os.clock() + 12
	end
end)
refugio.OnClientEvent:Connect(function(evento, ok)
	if evento ~= "SalidaAlFaro" or not ok then
		return
	end
	reintento = false
	despegueHasta = os.clock() + 12
	task.delay(0.15, function()
		local root = raiz()
		local cam = workspace.CurrentCamera
		if root and cam and (root.Position - faro.Despegue.Position).Magnitude < 8 then
			local rumbo = (faro.Llegada.Position - faro.Despegue.Position) * Vector3.new(1, 0, 1)
			if rumbo.Magnitude > 0.1 then
				cam.CFrame = CFrame.lookAt(root.Position + Vector3.yAxis * 5.85 - rumbo.Unit * 13, faro.Llegada.Position + Vector3.yAxis * 2)
			end
		end
	end)
end)

local transcurrido = 0
RunService.Heartbeat:Connect(function(dt)
	transcurrido += dt
	if transcurrido < 0.09 then
		return
	end
	transcurrido = 0
	local root = raiz()
	local dentro = jugador:GetAttribute("EnFaro") == true
	local cercaSalida = root and os.clock() < despegueHasta and (root.Position - faro.Despegue.Position).Magnitude < 16
	gui.Enabled = root ~= nil and (dentro or cercaSalida == true)
	if not gui.Enabled then
		return
	end
	local mando = UserInputService:GetLastInputType().Name:match("^Gamepad") ~= nil
	local tactil = UserInputService.TouchEnabled and not mando
	tarjeta.Position = UDim2.fromOffset(14, if dentro then 9 else 85)
	titulo.Text = if dentro then faro:GetAttribute("TituloFaro") or "Ruinas del Faro"
		elseif reintento then "Vuelve a probar el vuelo" else "Despegue hacia el faro"
	pista.Text = if dentro then faro:GetAttribute("PistaFaro") or ""
		else if tactil then "Salta y toca Planeo. Aterriza sobre la losa entre los pilares."
		elseif mando then "Salta y pulsa Y. Aterriza sobre la losa entre los pilares."
		else "Salta y pulsa F. Aterriza sobre la losa entre los pilares."
	luz.Visible = dentro and cercaDelRastro(root) == true
	local etapa = jugador:GetAttribute("RescateNimbo")
	if dentro and etapa then
		local aros = jugador:GetAttribute("ArosNimbo") or 0
		if etapa == "Subiendo" then
			titulo.Text, pista.Text = "Elevador de Prisma", "Mira los tres aros. El huevo está en la nube más allá del último."
		elseif etapa == "Caida" then
			titulo.Text, pista.Text = "Alas plegadas", "Aterriza en el nido o vuelve a intentarlo desde el balcón."
		elseif etapa == "Balcon" then
			titulo.Text, pista.Text = "Nido de tormenta", "Lánzate desde el borde dorado. Tres aros dan una oportunidad de Aurora (20 %)."
		elseif etapa == "Vuelo" then
			titulo.Text = ("Aros de Prisma   %d / 3"):format(aros)
			pista.Text = if tactil then "Dirige el planeador. Toca Plegar para cerrar las alas."
				elseif mando then "Dirige el planeador. Pulsa Y para plegar las alas."
				else "Dirige el planeador con WASD. Pulsa F para plegar las alas."
		elseif etapa == "Nido" then
			titulo.Text = if aros == 3 then "¡Tres aros de Prisma!" else "Llegaste al nido"
			pista.Text = "Acércate al huevo para abrir el cascarón."
		elseif etapa == "Eclosion" then
			titulo.Text, pista.Text = "El cascarón se mueve…", "Algo está a punto de salir."
		elseif etapa == "Rescatado" then
			titulo.Text = if jugador:GetAttribute("UltimaEclosionAurora") then "Nimbo Aurora" else "Nimbo, Eco de tormenta"
			pista.Text = "Ya vuela contigo. Usa la salida del nido para volver a la torre."
		end
	elseif dentro and jugador:GetAttribute("Prisma") and jugador:GetAttribute("FaroEncendido") then
		titulo.Text, pista.Text = "El huevo de la tormenta", "Prisma reveló tres aros. Acércate a la luz verde al pie de la torre."
	end
	luz.Text = if mando then "R1  ·  Iluminar con Lucero" elseif tactil then "Iluminar con Lucero" else "C  ·  Iluminar con Lucero"
end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{8A90BC39-8B2A-4822-A3B6-7E8C95101C59}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Faro</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">587218feabdd332f0b102bd400000436</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX01286727C7714C14A37C42473E07EE8B">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GuiService = game:GetService("GuiService")
local FormacionEcos = require(ReplicatedStorage:WaitForChild("FormacionEcos"))
local Eclosion = require(ReplicatedStorage:WaitForChild("EclosionNimbo"))
local usuario = Players.LocalPlayer
local faro = workspace:WaitForChild("IslaDelViento"):WaitForChild("RuinasDelFaro")
local ruta = faro:WaitForChild("RescateNimbo")
local modelos = ReplicatedStorage:WaitForChild("EcosDelFaro")
local remoto = ReplicatedStorage:WaitForChild("AccionFaro")
local huevo = ruta:WaitForChild("Huevo")
local menta,violeta = Color3.fromRGB(101,255,196),Color3.fromRGB(186,129,255)
local eclosion = Eclosion.new(ruta, modelos)

local salida=Instance.new("Attachment")
salida.Parent=faro.Linterna
local haces={}
local arcos={}
for i=1,3 do
	local aro=ruta.Aros[tostring(i)]
	local fin=Instance.new("Attachment")
	fin.Parent=aro.Centro
	local haz=Instance.new("Beam")
	haz.Attachment0,haz.Attachment1=salida,fin
	haz.Width0,haz.Width1,haz.FaceCamera=.34,.12,true
	haz.Color=ColorSequence.new(({menta,Color3.fromRGB(255,203,126),violeta})[i])
	haz.LightEmission,haz.Transparency,haz.Enabled=1,NumberSequence.new(.4),false
	haz.Parent=salida
	haces[i]=haz
	arcos[i] = {}
	for _,p in aro:GetChildren() do
		if p.Name=="Arco" then table.insert(arcos[i],p) end
	end
end
local subir=ruta.Ascensor:WaitForChild("Subir")
local saltar=ruta.Despegue:WaitForChild("Saltar")
local abrir=huevo:WaitForChild("Abrir")
local volver=ruta.Nido.Salida:WaitForChild("Volver")
local revelados = 0
local turnoSubida = 0
local function actualizar()
	local fase=usuario:GetAttribute("RescateNimbo")
	local visible=usuario:GetAttribute("EnFaro")==true and usuario:GetAttribute("Prisma")==true and usuario:GetAttribute("FaroEncendido")==true
	if not visible then revelados = 0 end
	for i, piezas in arcos do
		local mostrar = visible and i <= revelados
		for _, pieza in piezas do pieza.LocalTransparencyModifier = if mostrar then 0 else 1 end
		haces[i].Enabled = mostrar
	end
	subir.Enabled=visible and (fase==nil or fase=="Balcon")
	saltar.Enabled=visible and fase=="Balcon"
	abrir.Enabled=visible and fase=="Nido"
	volver.Enabled=visible and (fase=="Rescatado" or fase=="Nido")
	eclosion:estado(fase,usuario:GetAttribute("MarcasHuevo"),visible)
end
usuario:GetAttributeChangedSignal("RescateNimbo"):Connect(function()
	local fase = usuario:GetAttribute("RescateNimbo")
	turnoSubida += 1
	if fase == "Subiendo" then
		revelados = 0
		local turno = turnoSubida
		for i = 1, 3 do
			task.delay(i * .47, function()
				if turnoSubida == turno then revelados = i actualizar() end
			end)
		end
		if not GuiService.ReducedMotionEnabled then
			local cam = workspace.CurrentCamera
			local base = ruta.Ascensor.Position
			if cam and cam.CameraType == Enum.CameraType.Custom then
				cam.CFrame = CFrame.lookAt(base + Vector3.new(-3, 7, 11), base + Vector3.new(16, 8, -2))
			end
		end
	elseif fase == "Balcon" then
		revelados = 3
	end
	actualizar()
	if fase ~= "Balcon" or GuiService.ReducedMotionEnabled then return end
	local cam=workspace.CurrentCamera
	if cam and cam.CameraType==Enum.CameraType.Custom then
		local origen=ruta.Despegue.Position
		cam.CFrame=CFrame.lookAt(origen+Vector3.new(-9,7,0),origen+Vector3.new(20,2,0))
	end
end)
for _,a in {"MarcasHuevo","EnFaro","Prisma","FaroEncendido"} do
	usuario:GetAttributeChangedSignal(a):Connect(actualizar)
end
actualizar()
remoto.OnClientEvent:Connect(function(evento,aurora,inicio,duracion)
	if evento=="EclosionNimbo" then
		eclosion:iniciar(usuario,aurora,inicio,duracion)
	end
end)

local plantillaPedernal = ReplicatedStorage:WaitForChild("PedernalCompanero")
local equipos = {}

local function retirar(equipo, nombre)
	local eco = equipo[nombre]
	if eco then
		eco.modelo:Destroy()
		equipo[nombre] = nil
	end
end

local function companero(equipo, p, nombre, plantilla)
	local anterior = equipo[nombre]
	if anterior and anterior.plantilla == plantilla then return end
	retirar(equipo,nombre)
	if not plantilla then return end
	local m = plantilla:Clone()
	m.Name = if nombre=="Pedernal" then "PedernalExplorador" else plantilla.Name
	m:SetAttribute("DuenoEco",p.UserId)
	local eco = {modelo=m, plantilla=plantilla}
	if nombre=="Nimbo" then
		eco.alas = {m.AlaIzquierda,m.AlaDerecha}
		local base=m:GetPivot()
		eco.ejes={base:ToObjectSpace(eco.alas[1]:GetPivot()),base:ToObjectSpace(eco.alas[2]:GetPivot())}
	end
	equipo[nombre] = eco
end

local function observar(p)
	if equipos[p] then return end
	local equipo = {conexiones={}}
	equipos[p]=equipo
	local function sincronizar()
		local raiz = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		equipo.raiz=raiz
		local variante=if p:GetAttribute("NimboAurora") then modelos.NimboAurora else modelos.Nimbo
		companero(equipo,p,"Nimbo",if raiz and p:GetAttribute("Nimbo") then variante else nil)
		-- En la cueva el actor del guardián asume la revelación y las órdenes de Pedernal.
		companero(equipo,p,"Pedernal",if raiz and p:GetAttribute("Pedernal") and not p:GetAttribute("EnCueva")
			then plantillaPedernal else nil)
	end
	local function personaje(c)
		if c:WaitForChild("HumanoidRootPart",10) and p.Character==c and equipos[p]==equipo then sincronizar() end
	end
	for _, atributo in {"Nimbo","NimboAurora","Pedernal","EnCueva"} do
		table.insert(equipo.conexiones,p:GetAttributeChangedSignal(atributo):Connect(sincronizar))
	end
	table.insert(equipo.conexiones,p.CharacterAdded:Connect(personaje))
	table.insert(equipo.conexiones,p.CharacterRemoving:Connect(function()
		equipo.raiz=nil
		retirar(equipo,"Nimbo")
		retirar(equipo,"Pedernal")
	end))
	if p.Character then task.spawn(personaje,p.Character) end
end

local function quitar(p)
	local equipo = equipos[p]
	if not equipo then return end
	for _, conexion in equipo.conexiones do conexion:Disconnect() end
	retirar(equipo,"Nimbo")
	retirar(equipo,"Pedernal")
	equipos[p]=nil
end
Players.PlayerAdded:Connect(observar)
Players.PlayerRemoving:Connect(quitar)
for _,p in Players:GetPlayers() do observar(p) end

local function seguir(eco,nombre,raiz,t,dt,visible)
	if not eco then return end
	if not visible then
		if eco.modelo.Parent then eco.modelo.Parent=nil end
		return
	end
	local actual = if eco.modelo.Parent then eco.modelo:GetPivot() else nil
	local pose = FormacionEcos.pose(nombre,raiz.CFrame,t,actual,1-math.exp(-dt*6))
	eco.modelo:PivotTo(pose)
	if eco.alas then
		for i,ala in eco.alas do
			ala:PivotTo(pose*eco.ejes[i]*CFrame.Angles(0,0,(if i==1 then -1 else 1)*math.sin(t*8)*.30))
		end
	end
	if not eco.modelo.Parent then eco.modelo.Parent=workspace end
end

RunService.PreRender:Connect(function(dt)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local t=workspace:GetServerTimeNow()
	for p,equipo in equipos do
		local raiz = equipo.raiz
		if not raiz or not raiz.Parent then continue end
		local cerca = (cam.CFrame.Position-raiz.Position).Magnitude<190
		seguir(equipo.Nimbo,"Nimbo",raiz,t,dt,cerca and (p~=usuario or not eclosion.escena))
		seguir(equipo.Pedernal,"Pedernal",raiz,t,dt,cerca)
	end
end)]]></ProtectedString>
