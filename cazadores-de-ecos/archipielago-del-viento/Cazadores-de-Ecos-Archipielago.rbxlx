				<string name="Name">RescateNimbo</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">587218feabdd332f0b102bd4000027ab</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXBC5550983FAB4EE9ABF2C8FA0A3B4DEB">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Poses del modelo de piedra y efectos dirigidos. El servidor decide los impactos.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Visual = {}
Visual.__index = Visual

local ORO = Color3.fromRGB(255, 191, 99)
local VIOLETA = Color3.fromRGB(202, 149, 255)
local MENTA = Color3.fromRGB(128, 251, 223)
local HIELO = Color3.fromRGB(225, 255, 250)
local ARCILLA = Color3.fromRGB(92, 84, 107)
local rad = math.rad
local brazos = { Hombro = true, Brazo = true, ["Puño"] = true, ["Veta del hombro"] = true }
local cabeza = { Cabeza = true, Cejas = true, ["Mandíbula"] = true, Ojo = true }

local function segmento(a, b)
	return CFrame.lookAt((a + b) / 2, b)
end

function Visual.new(guardian, efectos, parte)
	local self = setmetatable({ guardian = guardian, efectos = efectos, parte = parte, juntas = {} }, Visual)
	local base = guardian:GetPivot()
	for _, pieza in guardian:GetChildren() do
		local esPuno = string.sub(pieza.Name, 1, 2) == "Pu"
		local esBrazo = brazos[pieza.Name] or esPuno
		local esCabeza = cabeza[pieza.Name] or string.sub(pieza.Name, 1, 4) == "Mand"
		if pieza:IsA("BasePart") and (esBrazo or esCabeza) then
			local reposo = base:ToObjectSpace(pieza.CFrame)
			local lado = math.sign(reposo.X)
			local pivote = if esBrazo then Vector3.new(lado * 3.15, 1.2, 0) else Vector3.new(0, 1.95, -0.2)
			local centro = CFrame.new(pivote)
			table.insert(self.juntas, {pieza = pieza, centro = centro, offset = centro:Inverse() * reposo, lado = lado,
				brazo = esBrazo, ojo = pieza.Name == "Ojo" and pieza.Color or nil})
			if esPuno and lado > 0 then
				self.puno = pieza
			end
		end
	end
	local columna = Instance.new("Model")
	columna.Name = "ColumnaAgrietada"
	columna.Parent = efectos
	self.centroColumna = Vector3.new(305, 20.08, 12.5)
	local pie = CFrame.new(self.centroColumna) * CFrame.Angles(0, rad(14), 0)
	for i, nivel in ipairs({
		{Vector3.new(4.2, 1.1, 3.8), CFrame.new(0, 0.55, 0)},
		{Vector3.new(2.9, 5.7, 2.65), CFrame.new(0, 3.85, 0)},
		{Vector3.new(3.3, 1.05, 2.95), CFrame.new(-0.23, 7.1, 0) * CFrame.Angles(0, 0, rad(7))},
	}) do
		local roca = parte(columna, "Estrato" .. i, nivel[1], pie * nivel[2], ARCILLA)
		roca.Material = Enum.Material.Slate
	end
	for _, cara in {-1, 1} do
		local puntos = {Vector3.new(-0.72, 6.7, cara * 1.34), Vector3.new(0.33, 4.9, cara * 1.34),
			Vector3.new(-0.56, 3.8, cara * 1.34), Vector3.new(0.35, 1.08, cara * 1.34)}
		for i = 2, #puntos do
			local anterior, punto = puntos[i - 1], puntos[i]
			local a, b = pie * anterior, pie * punto
			parte(columna, "Grieta", Vector3.new(0.17, 0.14, (b-a).Magnitude), segmento(a,b), ORO)
			a = pie * Vector3.new(cara * 1.46, anterior.Y, anterior.X)
			b = pie * Vector3.new(cara * 1.46, punto.Y, punto.X)
			parte(columna, "Grieta", Vector3.new(0.17, 0.14, (b-a).Magnitude), segmento(a,b), ORO)
		end
	end
	self.columna = columna
	self.filo = parte(efectos, "FiloDelBarrido", Vector3.one, CFrame.new(), VIOLETA)
	self.filo.Transparency = 1
	local rastroA = Instance.new("Attachment")
	local rastroB = Instance.new("Attachment")
	rastroA.Parent = self.filo
	rastroB.Parent = self.filo
	local rastro = Instance.new("Trail")
	rastro.Attachment0, rastro.Attachment1 = rastroA, rastroB
	rastro.Color = ColorSequence.new(VIOLETA, Color3.fromRGB(117, 91, 230))
	rastro.Transparency = NumberSequence.new(0.35, 1)
	rastro.Lifetime = 0.22
	rastro.LightEmission = 0.9
	rastro.Enabled = false
	rastro.Parent = self.filo
	self.rastro, self.rastroA, self.rastroB = rastro, rastroA, rastroB
	return self
end

function Visual:esquirlas(punto, color)
	for i = 1, 7 do
		local angulo = i * math.pi * 2 / 7
		local salida = Vector3.new(math.cos(angulo), 0.65 + (i % 3) * 0.24, math.sin(angulo)).Unit
		local inicio = punto + salida * 0.38
		local final = inicio + salida * (2.2 + i % 3)
		local p = self.parte(self.efectos, "Esquirla", Vector3.new(0.22, 0.33, 0.82),
			CFrame.lookAt(inicio, final), color)
		TweenService:Create(p, TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{CFrame = p.CFrame + (final - inicio), Transparency = 1}):Play()
		Debris:AddItem(p, 0.42)
	end
end

function Visual:mostrarColumna(visible)
	for _, pieza in self.columna:GetChildren() do
		pieza.Transparency = if visible then 0 else 1
		if pieza.Material == Enum.Material.Slate then
			pieza.CanCollide = visible
			pieza.CanQuery = visible
		end
	end
	if not visible then
		self:esquirlas(self.centroColumna + Vector3.yAxis * 4, ORO)
	end
end

function Visual:rafaga(origen, destino)
	local distancia = (destino - origen).Magnitude
	if distancia < 0.15 then return end
	local marco = CFrame.lookAt(origen, destino)
	for i = -1, 1 do
		local inicio = origen + marco.RightVector * i * 0.65
		local fin = destino + marco.RightVector * i * 0.13
		local flecha = self.parte(self.efectos, "LanzaDeViento", Vector3.new(0.22, 0.38, math.min(3.5, distancia * 0.55)),
			CFrame.lookAt(inicio, fin), if i == 0 then HIELO else MENTA)
		TweenService:Create(flecha, TweenInfo.new(0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{CFrame = CFrame.lookAt(fin, fin + marco.LookVector), Transparency = 1}):Play()
		Debris:AddItem(flecha, 0.21)
	end
end

-- El mismo arco horizontal se usa para buscar impactos y dibujar la hoja.
Visual.inicioBarrido = 79
Visual.recorridoBarrido = 177
function Visual.direccionBarrido(base, progreso)
	local angulo = rad(Visual.inicioBarrido - Visual.recorridoBarrido * math.clamp(progreso, 0, 1))
	return base.LookVector * math.cos(angulo) + base.RightVector * math.sin(angulo)
end

function Visual:pose(estado, progreso)
	local base = self.guardian:GetPivot()
	local elevacion, torsion, mirada, inclinacion = 0, 0, 0, 0
	local despertar = 0
	if estado == "Presentacion" then
		despertar = math.clamp((progreso - 0.06) / 0.40, 0, 1)
		local levanta = math.clamp(progreso / 0.52, 0, 1)
		local planta = math.clamp((progreso - 0.55) / 0.13, 0, 1)
		elevacion, inclinacion = 80 * levanta * (1 - planta), (1 - progreso) * 25
	elseif estado == "Aviso" or estado == "Embestida" then
		elevacion, inclinacion = -26 * progreso, 24 * progreso
	elseif estado == "PrepararBarrido" then
		elevacion, torsion, mirada = 39 * progreso, -72 * progreso, -20 * progreso
	elseif estado == "Barrido" then
		elevacion, torsion, mirada = 39, -72 + 145 * progreso, -20 + 48 * progreso
	elseif estado == "Expuesto" or estado == "SigueACometa" then
		inclinacion, elevacion = 25, -17
	end
	for _, j in self.juntas do
		local rotacion
		if j.brazo then
			if estado == "Presentacion" and j.lado < 0 then
				rotacion = CFrame.Angles(rad(elevacion * 0.25), 0, rad(-11 * elevacion / 80))
			elseif (estado == "PrepararBarrido" or estado == "Barrido") and j.lado < 0 then
				rotacion = CFrame.Angles(rad(-15), 0, rad(-8))
			else
				rotacion = CFrame.Angles(0, rad(torsion), 0) * CFrame.Angles(rad(elevacion), 0, rad(j.lado * elevacion * 0.58))
			end
		else
			rotacion = CFrame.Angles(rad(inclinacion), rad(mirada), 0)
		end
		j.pieza.CFrame = base * j.centro * rotacion * j.offset
		if j.ojo then
			j.pieza.Color = if estado == "Presentacion" then Color3.fromRGB(49, 39, 41):Lerp(j.ojo, despertar) else j.ojo
		end
	end
	local preparando, barriendo = estado == "PrepararBarrido", estado == "Barrido"
	if preparando or barriendo then
		local direccion = Visual.direccionBarrido(base, if preparando then 0 else progreso)
		local punta = base.Position + direccion * (if preparando then 4.7 + 5.8 * progreso else 10.5) - Vector3.yAxis * 2.1
		local origen = self.puno.Position
		local largo = math.max((punta - origen).Magnitude, 0.1)
		self.filo.Size = Vector3.new(0.58, 0.48, largo)
		self.filo.CFrame = segmento(origen, punta)
		self.filo.Transparency = if preparando then 0.50 - progreso * 0.28 else 0.04
		self.rastroA.Position, self.rastroB.Position = Vector3.new(0,0,largo/2), Vector3.new(0,0,-largo/2)
		self.rastro.Enabled = barriendo
	else
		self.filo.Transparency = 1
		self.rastro.Enabled = false
	end
end

return Visual]]></ProtectedString>
				<string name="ScriptGuid">{2514654D-7B6F-4E5B-AE35-D590D53FCAE6}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">GuardianVisual</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">587218feabdd332f0b102bd400004e15</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXFA492B92A0DB4594AECB1150BF70D5E9">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- El servidor anima el mismo bastón que ven el atacante y los demás jugadores.
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Baston = {}
local equipados = {}
local madera = Color3.fromRGB(91, 65, 54)
local laton = Color3.fromRGB(219, 166, 88)
local luz = Color3.fromRGB(141, 255, 230)
local rad = math.rad

local function pieza(modelo, nombre, medida, marco, material, color)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = nombre, medida, marco
	p.Material, p.Color = material, color
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow, p.Massless = false, false, false, false, true
	p.Parent = modelo
	return p
end

function Baston.equipar(personaje)
	if not personaje then return nil end
	if equipados[personaje] then return equipados[personaje] end
	local mano = personaje:FindFirstChild("RightHand") or personaje:FindFirstChild("Right Arm")
	local torso = personaje:FindFirstChild("UpperTorso") or personaje:FindFirstChild("Torso")
	if not mano or not torso then return nil end
	local modelo = Instance.new("Model")
	modelo.Name = "BastonDeResonancia"
	local agarre = CFrame.new(0, if mano.Name == "Right Arm" then -0.94 else -0.14, -0.15) * CFrame.Angles(rad(-17), 0, rad(-11))
	local mango = pieza(modelo, "Asta", Vector3.new(.19, 4.2, .22), mano.CFrame * agarre, Enum.Material.Wood, madera)
	modelo.PrimaryPart = mango
	local function tallar(nombre, medida, offset, material, color)
		local p = pieza(modelo, nombre, medida, mango.CFrame * offset, material, color)
		local union = Instance.new("WeldConstraint")
		union.Part0, union.Part1, union.Parent = mango, p, p
		return p
	end
	for _,y in {-1.94, -.34, .34, 1.88} do
		tallar("Anillo", Vector3.new(.27,.14,.29), CFrame.new(0,y,0), Enum.Material.Metal, laton)
	end
	for _,lado in {-1,1} do
		tallar("Diapasón", Vector3.new(.11,.70,.17), CFrame.new(lado*.18,2.20,0)*CFrame.Angles(0,0,rad(-lado*24)), Enum.Material.Metal, laton)
	end
	tallar("Geoda", Vector3.new(.41,.54,.41), CFrame.new(0,2.66,0)*CFrame.Angles(0,rad(45),rad(35)), Enum.Material.Neon, luz)
	local raiz, punta = Instance.new("Attachment"), Instance.new("Attachment")
	raiz.Position, punta.Position = Vector3.new(0,.6,0), Vector3.new(0,2.94,0)
	raiz.Parent, punta.Parent = mango, mango
	local estela = Instance.new("Trail")
	estela.Attachment0, estela.Attachment1 = raiz, punta
	estela.Enabled, estela.FaceCamera, estela.LightEmission = false, true, .8
	estela.Lifetime, estela.MinLength = .20, .025
	estela.Color = ColorSequence.new(luz, Color3.fromRGB(244, 212, 122))
	estela.Transparency = NumberSequence.new(.2, 1)
	estela.Parent = mango
	local grip = Instance.new("Motor6D")
	grip.Name, grip.Part0, grip.Part1, grip.C0, grip.Parent = "Empuñadura", mano, mango, agarre, mango
	local hombro = personaje:FindFirstChild("RightShoulder", true) or torso:FindFirstChild("Right Shoulder")
	local cintura = personaje:FindFirstChild("Waist", true)
	local e = {modelo = modelo, mango = mango, estela = estela, juntas = {}, orden = 0}
	for i,j in {grip, hombro, cintura} do
		if j and j:IsA("Motor6D") then e.juntas[i] = {motor=j, base=j.C0} end
	end
	equipados[personaje] = e
	local function limpiar()
		if equipados[personaje] ~= e then return end
		equipados[personaje] = nil
		if e.muerte then e.muerte:Disconnect() end
		for _,j in e.juntas do
			if j.tween then j.tween:Cancel() end
			if j.motor.Parent then j.motor.C0 = j.base end
		end
	end
	e.limpiar = limpiar
	modelo.Destroying:Once(limpiar)
	local humanoide = personaje:FindFirstChildOfClass("Humanoid")
	if humanoide then
		e.muerte = humanoide.Died:Once(function()
			if equipados[personaje] == e then Baston.quitar(personaje) end
		end)
	end
	modelo.Parent = personaje
	return e
end

function Baston.quitar(personaje)
	local e = personaje and equipados[personaje]
	if e then
		e.limpiar()
		e.modelo:Destroy()
	end
end

function Baston.enArco(root, punto, alcance)
	local d = punto - root.Position
	if d.Magnitude > alcance or math.abs(d.Y) > 5.5 then return false end
	local plano = Vector3.new(d.X,0,d.Z)
	local frente = root.CFrame.LookVector * Vector3.new(1,0,1)
	return plano.Magnitude < .65 or (frente.Magnitude > .01 and frente.Unit:Dot(plano.Unit) >= .34)
end

local function postura(e, duracion, giros)
	for i,j in e.juntas do
		if not j.motor.Parent then continue end
		if j.tween then j.tween:Cancel() end
		local r = giros[i] or CFrame.identity
		local destino = CFrame.new(j.base.Position) * r * j.base.Rotation
		j.tween = TweenService:Create(j.motor, TweenInfo.new(duracion,Enum.EasingStyle.Quad,Enum.EasingDirection.Out), {C0=destino})
		j.tween:Play()
	end
end

function Baston.golpear(root, impacto, guardar)
	local personaje = root.Parent
	local e = Baston.equipar(personaje)
	if not e then return end
	e.orden += 1
	local orden = e.orden
	local function vigente()
		local h = personaje:FindFirstChildOfClass("Humanoid")
		return e.modelo.Parent == personaje and root.Parent == personaje and h and h.Health > 0 and e.orden == orden
	end
	postura(e,.11,{CFrame.Angles(rad(-52),0,rad(-38)),CFrame.Angles(rad(73),rad(-33),rad(41)),CFrame.Angles(0,rad(-21),0)})
	task.delay(.11,function()
		if not vigente() then return end
		e.estela.Enabled = true
		postura(e,.16,{CFrame.Angles(rad(-76),0,rad(43)),CFrame.Angles(rad(89),rad(64),rad(-23)),CFrame.Angles(0,rad(30),rad(-5))})
	end)
	task.delay(.20,function()
		if vigente() then impacto() end
	end)
	task.delay(.30,function()
		if not vigente() then return end
		e.estela.Enabled = false
		postura(e,.24,{})
	end)
	if guardar then
		task.delay(1.3,function()
			if vigente() and guardar() then Baston.quitar(personaje) end
		end)
	end
end

function Baston.impacto(punto, tipo, efectos)
	local cristal = tipo == "Cristal"
	local color = if cristal then luz elseif tipo == "Armadura" then laton else Color3.fromRGB(255, 172, 126)
	local chispa = pieza(efectos, "Impacto"..tipo, Vector3.one*.48, CFrame.new(punto), Enum.Material.Neon, color)
	chispa.Anchored, chispa.Shape = true, Enum.PartType.Ball
	local sonido = Instance.new("Sound")
	sonido.SoundId = if cristal then "rbxasset://sounds/volume_slider.ogg" else "rbxasset://sounds/action_jump_land.mp3"
	sonido.Volume, sonido.PlaybackSpeed, sonido.RollOffMaxDistance = .45, if cristal then 1.48 else 1.35, 56
	sonido.Parent = chispa
	sonido:Play()
	TweenService:Create(chispa,TweenInfo.new(.2),{Size=Vector3.one*(if cristal then 2.3 else 1.35),Transparency=1}):Play()
	Debris:AddItem(chispa,1.5)
end

return Baston]]></ProtectedString>
				<string name="ScriptGuid">{C8AE59CD-A973-411A-90A3-570A10BBA4CA}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">BastonResonancia</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">30a1ef7f4e3e73a90b10ce17000009f7</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXBE151B77B5E147319F6070052434B664">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Visual = {}
local cielo = Color3.fromRGB(137, 227, 255)
local oro = Color3.fromRGB(255, 212, 119)
local coral = Color3.fromRGB(255, 144, 123)

local function anclar(padre, posicion)
	local a = Instance.new("Attachment")
	a.Position, a.Parent = posicion, padre
	return a
end

local function trazo(padre, a, b, color, grosor)
	local linea = Instance.new("Beam")
	linea.Attachment0, linea.Attachment1 = a, b
	linea.Color, linea.Transparency = ColorSequence.new(color), NumberSequence.new(.23)
	linea.FaceCamera, linea.LightEmission = true, .85
	linea.Width0, linea.Width1, linea.Parent = grosor, grosor, padre
	return linea
end

function Visual.escudo(burbuja)
	burbuja.Color, burbuja.Material, burbuja.Transparency = cielo, Enum.Material.ForceField, .54
	local radio = burbuja.Size.X * .49
	for banda = 0,1 do
		local anterior
		for i=0,8 do
			local angulo = i*math.pi/4
			local offset = Vector3.new(math.cos(angulo), math.sin(angulo)*.49*(if banda==0 then 1 else -1),math.sin(angulo)*.87)*radio
			local actual = anclar(burbuja,offset)
			if anterior then trazo(burbuja,anterior,actual,cielo,.075) end
			anterior = actual
		end
	end
end

local function pulso(padre, nombre, centro, color, medida)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = nombre, medida, CFrame.new(centro)
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true,false,false,false,false
	p.Material, p.Color = Enum.Material.Neon,color
	p.Parent = padre
	return p
end

-- La dirección indica el sentido en el que viaja la ráfaga.
function Visual.impacto(centro, direccion, tipo, padre)
	local normal = if direccion.Magnitude > .01 then direccion.Unit else Vector3.zAxis
	local color = if tipo == "Rebote" then oro elseif tipo == "Bloqueo" then cielo else coral
	local lugar = centro - normal*(if tipo == "Daño" then 1 else 3)
	local frente = CFrame.lookAt(lugar,lugar+normal)
	for i=1,6 do
		local angulo = i*math.pi/3
		local radial = frente.RightVector*math.cos(angulo)+frente.UpVector*math.sin(angulo)
		local p = pulso(padre,"AstillaDe"..tipo,lugar+radial*.32,color,Vector3.new(.18,.18,.74))
		p.CFrame=CFrame.lookAt(p.Position,p.Position+radial)
		TweenService:Create(p,TweenInfo.new(.3),{CFrame=p.CFrame+radial*2.3-normal*.65,Transparency=1}):Play()
		Debris:AddItem(p,.34)
	end
end

function Visual.estela(pieza)
	local a,b=anclar(pieza,Vector3.yAxis*.6),anclar(pieza,-Vector3.yAxis*.6)
	local r=Instance.new("Trail")
	r.Name="ColaDelViento"
	r.Attachment0,r.Attachment1=a,b
	r.FaceCamera,r.LightEmission,r.Lifetime=true,.9,.42
	r.Color=ColorSequence.new(pieza.Color,Color3.fromRGB(229,231,255))
	r.Transparency=NumberSequence.new(.12,1)
	r.Parent=pieza
	return r
end

function Visual.avisar(origen, destino, color, padre)
	if (destino-origen).Magnitude < .1 then return end
	local base=CFrame.lookAt(origen,destino)
	local distancia=(destino-origen).Magnitude
	for i=-1,1 do
		local pos=origen+base.RightVector*i*.72+base.UpVector*math.abs(i)*.15
		local cinta=pulso(padre,"HebraDeCorriente",pos,color,Vector3.new(.09,.16,1.55))
		cinta.CFrame=CFrame.lookAt(pos,pos+base.LookVector)
		TweenService:Create(cinta,TweenInfo.new(.45,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{CFrame=cinta.CFrame+base.LookVector*distancia,Transparency=.96}):Play()
		Debris:AddItem(cinta,.49)
	end
end

return Visual]]></ProtectedString>
				<string name="ScriptGuid">{66429BCB-AC60-4598-9444-65EA65487B76}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">VientoVisual</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
