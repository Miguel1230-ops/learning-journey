		<Item class="ModuleScript" referent="RBX304FB2CA838C4ADF8EAD5821C79E3EA5">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Cada destino se deduce de los hitos del jugador, también al cargar una partida antigua.
local Ruta = {}
local destinos = {
	Aro = {"El primer vuelo de Cometa", "Desde el arco del puente, toma la rampa turquesa. Salta, abre el planeador y atraviesa el aro.", "Cometa siente el viento del aro. Busca la rampa junto al puente levadizo."},
	Cornisa = {"Remonta la corriente", "Con Vendaval, entra planeando en la espiral azul y sal hacia la baliza de la cornisa.", "Sigue las cintas ascendentes. Enciende la baliza y baja al refugio."},
	Taller = {"El primer escudo de Pedernal", "El Farero ofrece Escudo rápido por 60 monedas. Puedes llevarlo al relevo o zarpar hacia el Molino.", "Prueba el escudo en los dos faroles de mi pasarela. En el taller puedo prepararlo para el relevo."},
	Relevo = {"Relevo de los faroles", "Acepta el relevo junto al primer farol. Su chispa te mostrará el camino al Molino.", "Mira la llama. Cuando se incline, cúbrela con Pedernal. Lleva la chispa al segundo farol."},
	Inicio = {"Rescate en la Isla del Viento", "Acércate al tótem para defender el nido y rescatar a Cometa.", "El nido necesita ayuda. Busca el tótem de la Isla del Viento."},
	Refugio = {"Lleva a Cometa al refugio", "Cruza el puente y completa el rescate en la marca del refugio.", "Completa el rescate en la marca junto al puente y ven a verme."},
	Farero = {"Habla con el Farero", "Está bajo el toldo del refugio, junto al portal violeta.", "El viento del Molino te tumbará. Entra en el portal violeta junto a mi puesto y rescata a Pedernal. Su escudo te cubrirá."},
	Geoda = {"Portal de la Geoda", "Entra en el portal violeta junto al Farero y consigue el escudo de Pedernal.", "El viento del Molino te tumbará. Entra en el portal violeta junto a mi puesto y rescata a Pedernal. Su escudo te cubrirá."},
	Molino = {"Rumbo al Molino", "Desde la playa de despegue, salta y planea hacia el molino. Lleva a Pedernal.", "Pedernal ya está contigo. Su escudo protegerá la chispa en el Molino."},
	Consulta = {"Vuelve con Lucero al Farero", "El Farero sabe qué falta para explorar las ruinas.", "Lucero puede abrir el Faro, pero el espejo necesita la lente del guardián. El portal de la revancha está aquí al lado."},
	Revancha = {"Recupera la lente", "Entra al portal de la Geoda junto al Farero y gana la revancha.", "Pídele la revancha al guardián. Regresa por la salida verde con la lente."},
	Faro = {"Zarpa hacia las Ruinas", "Habla con el Farero para llegar al punto de despegue.", "¡Traes la lente y a Lucero! Sigue la señal y monta la lente junto al espejo."},
	Nido = {"Nido de tormenta", "Vuelve al Faro con el Farero. Prisma revela los aros que llevan al huevo.", "Prisma ya ilumina el recorrido. El elevador de la torre te llevará hasta el salto."},
	Libre = {"Exploración libre", "Puedes volver a la torre y recorrer los tres aros de Prisma.", "La torre está abierta. Puedes volar de nuevo cuando quieras."},
}
function Ruta.destino(p)
	local id
	if p:GetAttribute("Nimbo") then id = "Libre"
	elseif p:GetAttribute("Prisma") then id = "Nido"
	elseif p:GetAttribute("Lucero") then
		if p:GetAttribute("LenteGeoda") then id = "Faro"
		elseif p:GetAttribute("ConsejoLente") then id = "Revancha"
		else id = "Consulta" end
	elseif p:GetAttribute("Pedernal") then
		if p:GetAttribute("EncargoPedernal") or p:GetAttribute("MolinoVista") then id = "Molino"
		elseif p:GetAttribute("MejoraPedernal") then id = "Relevo"
		elseif (p:GetAttribute("Nivel") or 1) >= 2 and (p:GetAttribute("Monedas") or 0) >= 60 then id = "Taller"
		else id = "Molino" end
	elseif not p:GetAttribute("Cometa") then id = "Inicio"
	elseif not p:GetAttribute("Refugio") and not p:GetAttribute("Vendaval") then id = "Aro"
	elseif not p:GetAttribute("Refugio") and not p:GetAttribute("Cornisa") then id = "Cornisa"
	elseif not p:GetAttribute("Refugio") then id = "Refugio"
	elseif p:GetAttribute("ConsejoGeoda") then id = "Geoda"
	else id = "Farero" end
	return id, destinos[id]
end
return Ruta]]></ProtectedString>
				<string name="ScriptGuid">{9B7913B4-C698-4082-8F65-405BFE7099EE}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">RutaIslas</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">587218feabdd332f0b102bd40000393d</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXACAFBEB084714B4F98173B41479DA9CC">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Los cuatro puestos son relativos al rumbo del avatar. Z positivo queda detrás.
local puestos = {
	Cometa = { sitio = Vector3.new(5, 2.1, 1.4), ritmo = 3.5, amplitud = 0.30 },
	Lucero = { sitio = Vector3.new(-4.7, 2.5, 1.8), ritmo = 3.6, amplitud = 0.22 },
	Pedernal = { sitio = Vector3.new(2.2, 0.2, 6.1), ritmo = 2.6, amplitud = 0.14 },
	Nimbo = { sitio = Vector3.new(-2.1, 4.6, 7.8), ritmo = 3, amplitud = 0.32 },
}

local FormacionEcos = {}

function FormacionEcos.pose(nombre, raiz, tiempo, actual, avance)
	local puesto = puestos[nombre]
	local frente = raiz.LookVector * Vector3.new(1, 0, 1)
	if frente.Magnitude < 0.001 then
		frente = Vector3.yAxis:Cross(raiz.RightVector)
	end
	local marco = CFrame.lookAt(raiz.Position, raiz.Position + frente.Unit)
	local desplazamiento = puesto.sitio + Vector3.yAxis * (math.sin(tiempo * puesto.ritmo) * puesto.amplitud)
	if actual then
		-- Interpolar el centro de la formación hace que cada Eco rodee al avatar al girar.
		local centroAnterior = actual * CFrame.new(-desplazamiento)
		if (centroAnterior.Position - raiz.Position).Magnitude < 55 then
			marco = centroAnterior:Lerp(marco, avance)
		end
	end
	return marco * CFrame.new(desplazamiento)
end

return FormacionEcos]]></ProtectedString>
				<string name="ScriptGuid">{3CD4B2C9-E321-4714-80C5-A76EE9DF8739}</string>
